    "lifecycle_state": "Initial",
    "details": {
      "en": {
        "id": "en",
        "purpose": "To provide rule-based decision support for selected prosthodontic treatment options in posterior single-tooth replacement. The guideline identifies available or excluded options and relevant cautions based on defined clinical findings, supporting transparent clinical reasoning and shared decision-making.",
        "use": "Intended for use as part of a clinical decision-support demonstration. The guideline evaluates a selected posterior missing tooth using adjacent tooth presence, distal tooth count and HbA1c. Its outputs support discussion of treatment alternatives and shared patient-practitioner decision making.\n",
        "misuse": "Not intended for autonomous treatment selection, comprehensive prosthodontic diagnosis, or use as the sole basis for clinical decisions. Rule-based availability does not establish overall clinical suitability. The guideline does not assess all relevant anatomical, periodontal, biomechanical, systemic or patient-specific factors. It has not undergone clinical validation."
      }
    },
    "other_details": {}
  },
  "definition": {
    "data_bindings": {
      "gt0004": {
        "id": "gt0004",
        "model_id": "openEHR-EHR-OBSERVATION.dental_prosthodontic_assessment.v0",
        "template_id": "openEHR-EHR-OBSERVATION.dental_prosthodontic_assessment.v0",
        "type": "INPUT",
        "elements": {
          "gt0006": {
            "id": "gt0006",
            "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0005]"
          },
          "gt0007": {
            "id": "gt0007",
            "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0006]"
          },
          "gt0008": {
            "id": "gt0008",
            "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0007]"
          },
          "gt0009": {
            "id": "gt0009",
            "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0008]"
          },
          "gt0010": {
            "id": "gt0010",
            "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0009]"
          },
          "gt0038": {
            "id": "gt0038",
            "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0010]"
          }
        }
      },
      "gt0023": {
        "id": "gt0023",
        "model_id": "openEHR-EHR-EVALUATION.prosthodontic_decision_support_result.v0",
        "template_id": "openEHR-EHR-EVALUATION.prosthodontic_decision_support_result.v0",
        "type": "OUTPUT",
        "elements": {
          "gt0024": {
            "id": "gt0024",
            "path": "/data[at0001]/items[at0002]"
          },
          "gt0025": {
            "id": "gt0025",
            "path": "/data[at0001]/items[at0007]"
          }
        }
      }
    },
    "rules": {
      "gt0026": {
        "id": "gt0026",
        "priority": 7,
        "when": [
          "$gt0006|Target tooth missing|==true",
          "$gt0007|Target tooth posterior|==true",
          "$gt0008|Mesial adjacent tooth present|==true",
          "$gt0009|Distal adjacent tooth present|==true"
        ],
        "then": [
          "$gt0024|Treatment option|=local::at0003|Conventional FDP|",
          "$gt0025|Decision status|=local::at0008|Available|"
        ]
      },
      "gt0027": {
        "id": "gt0027",
        "priority": 6,
        "when": [
          "$gt0006|Target tooth missing|==true",
          "$gt0007|Target tooth posterior|==true",
          "($gt0008|Mesial adjacent tooth present|==false)||($gt0009|Distal adjacent tooth present|==false)"
        ],
        "then": [
          "$gt0024|Treatment option|=local::at0003|Conventional FDP|",
          "$gt0025|Decision status|=local::at0009|Excluded|"
        ]
      },
      "gt0028": {
        "id": "gt0028",
        "priority": 5,
        "when": [
          "$gt0006|Target tooth missing|==true",
          "$gt0007|Target tooth posterior|==true"
        ],
        "then": [
          "$gt0024|Treatment option|=local::at0004|Implant-supported crown|",
          "$gt0025|Decision status|=local::at0008|Available|"
        ]
      },
      "gt0029": {
        "id": "gt0029",
        "priority": 4,
        "when": [
          "$gt0006|Target tooth missing|==true",
          "$gt0007|Target tooth posterior|==true",
          "$gt0038|HbA1c|>=8,%"
        ],
        "then": [
          "$gt0024|Treatment option|=local::at0004|Implant-supported crown|",
          "$gt0025|Decision status|=local::at0010|Caution|"
        ]
      },
      "gt0030": {
        "id": "gt0030",
        "priority": 3,
        "when": [
          "$gt0006|Target tooth missing|==true",
          "$gt0007|Target tooth posterior|==true"
        ],
        "then": [
          "$gt0024|Treatment option|=local::at0005|Removable partial denture|",
          "$gt0025|Decision status|=local::at0008|Available|"
        ]
      },
      "gt0031": {
        "id": "gt0031",
        "priority": 2,
        "when": [
          "$gt0006|Target tooth missing|==true",
          "$gt0007|Target tooth posterior|==true",
          "$gt0010|Distal teeth present count|>=2"
        ],
        "then": [
          "$gt0024|Treatment option|=local::at0006|Posterior cantilever FDP|",
          "$gt0025|Decision status|=local::at0008|Available|"
        ]
      },
      "gt0032": {
        "id": "gt0032",
        "priority": 1,
        "when": [
          "$gt0006|Target tooth missing|==true",
          "$gt0007|Target tooth posterior|==true",
          "$gt0010|Distal teeth present count|<2"
        ],
        "then": [
          "$gt0024|Treatment option|=local::at0006|Posterior cantilever FDP|",
          "$gt0025|Decision status|=local::at0009|Excluded|"
        ]
      }
    }
  },
  "ontology": {
    "term_definitions": {
      "en": {
        "id": "en",
        "terms": {
          "gt0001": {
            "id": "gt0001",
            "text": "Prosthodontic treatment option decision support",
            "description": "Decision support for prosthodontic treatment options in posterior single-tooth replacement."
          },
          "gt0006": {
            "id": "gt0006",
            "text": "Target tooth missing",
            "description": "Whether the selected tooth is absent."
          },
          "gt0007": {
            "id": "gt0007",
            "text": "Target tooth posterior",
            "description": "Whether the selected tooth is a premolar or molar."
          },
          "gt0008": {
            "id": "gt0008",
            "text": "Mesial adjacent tooth present",
            "description": "Whether the tooth immediately mesial to the selected tooth is present."
          },
          "gt0009": {
            "id": "gt0009",
            "text": "Distal adjacent tooth present",
            "description": "Whether the tooth immediately distal to the selected tooth is present."
          },
          "gt0010": {
            "id": "gt0010",
            "text": "Distal teeth present count",
            "description": "Number of teeth present distal to the selected tooth within the same quadrant."
          },
          "gt0014": {
            "id": "gt0014",
            "text": "Test name",
            "description": "Name of the laboratory test."
          },
          "gt0024": {
            "id": "gt0024",
            "text": "Treatment option",
            "description": "Prosthodontic treatment evaluated by the rule."
          },
          "gt0025": {
            "id": "gt0025",
            "text": "Decision status",
            "description": "Rule outcome: Available, Excluded or Caution."
          },
          "gt0026": {
            "id": "gt0026",
            "text": "FDP-01 Available",
            "description": "The target posterior tooth is missing. Both adjacent teeth are present. A conventional FDP can be supported."
          },
          "gt0027": {
            "id": "gt0027",
            "text": "FDP-02 Excluded",
            "description": "The target posterior tooth is missing. One or both adjacent teeth are absent. A conventional FDP cannot be supported."
          },
          "gt0028": {
            "id": "gt0028",
            "text": "IMP-01",
            "description": "The target posterior tooth is missing. An implant-supported crown is possible."
          },
          "gt0029": {
            "id": "gt0029",
            "text": "IMP-02 Caution",
            "description": "HbA1c is 8% or higher. Poor glycemic control may increase the risk of implant-related complications."
          },
          "gt0030": {
            "id": "gt0030",
            "text": "RPD-01 Available",
            "description": "The target posterior tooth is missing. A removable partial denture is possible."
          },
          "gt0031": {
            "id": "gt0031",
            "text": "CANT-01 Available",
            "description": "The target posterior tooth is missing. At least two distal teeth are present. A cantilever FDP can be supported."
          },
          "gt0032": {
            "id": "gt0032",
            "text": "CANT-02 Excluded",
            "description": "The target posterior tooth is missing. Fewer than two distal teeth are present. A cantilever FDP cannot be supported."
          },
          "gt0034": {
            "id": "gt0034",
            "text": "Test name",
            "description": "Name of the laboratory test."
          },
          "gt0036": {
            "id": "gt0036",
            "text": "Analyte name",
            "description": "Name of the substance or component measured by the laboratory test."
          },
          "gt0038": {
            "id": "gt0038",
            "text": "HbA1c",
            "description": "Glycated haemoglobin (HbA1c), expressed as a percentage."
          }
        }
      }
    },
