archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.ichom_diagnosis_outcomes.v0

concept
	[at0000]	-- Lung cancer diagnosis outcomes
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Blanca Flores">
		["organisation"] = <"Cambio Healthcare Systems">
		["email"] = <"blanca.flores@cambio.se">
		["date"] = <"2015-11-26">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To register diagnosis outcomes for the ICHOM data collection standards.">
			use = <"To register diagnosis outcomes for cancer patients.">
			keywords = <"lung cancer", "diagnosis outcomes", "ICHOM">
			misuse = <"Do not use to register data outside the ICHOM measures.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["references"] = <"ICHOM Lung Cancer Data Collection Reference Guide. International Consortium for Health Outcome Measurement. Version 2.1. Revised April 24th, 2015. ">
		["MD5-CAM-1.0.1"] = <"5931554478E23343BB57778BBAEBECD4">
	>

definition
	OBSERVATION[at0000] matches {	-- Lung cancer diagnosis outcomes
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Pathologic or clinical diagnosis
										value matches {
											DV_DATE_TIME matches {
												value matches {yyyy-mm-ddTHH:MM:SS}
											}
										}
									}
									ELEMENT[at0005] occurrences matches {0..1} matches {	-- Pathologic or clinical diagnosis method
										value matches {
											1|[local::at0006], 	-- Date specimen taken
											2|[local::at0007], 	-- Date specimen received
											3|[local::at0008], 	-- Date of pathology report Clinical diagnosis (if pathologic diagnosis unavailable)
											4|[local::at0009], 	-- Date of admission to hospital because of this malignancy
											5|[local::at0010], 	-- Date of first consultation at the outpatient clinic because of this malignancy (if only outpatient data available)
											888|[local::at0011]  	-- Other
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

