archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.mews.v0

concept
	[at0000]	-- Modified Early Warning Score
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Konstantino">
		["organisation"] = <"Cambio Healthcare Systems">
		["email"] = <"Kalliamvakos">
		["date"] = <"2014-10-01">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record/provide a composite score based on categorising physiological readings and observations, as a simple method to support objective assessment of the degree of illness in an unwell patient.">
			use = <"Use to record a composite score to support assessmennt of the degree of illness in an unwell patient.">
			keywords = <"early warning", "modified early warning score", "MEWS", "degree of illness">
			misuse = <"Not to be used to record National Early Warning Score (NEWS). Use openEHR-EHR-OBSERVATION.news.v1 instead.">
			copyright = <"">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. Modified Early Warning Scale, MEWS. Capio S:t Görans Sjukhus. Version 4.0. 2011-09-05">
		["MD5-CAM-1.0.1"] = <"A64CA5606DFAB206D2CFB849F9234FD9">
	>

definition
	OBSERVATION[at0000] matches {	-- Modified Early Warning Score
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Respiratory Rate
										value matches {
											0|[local::at0005], 	-- 9/min - 14/min
											1|[local::at0006], 	-- 15/min - 20/min
											2|[local::at0007], 	-- <9/min or 21/min - 29/min
											3|[local::at0008]  	-- >= 30/min
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {	-- Heart Rate
										value matches {
											0|[local::at0010], 	-- 51/min - 100/min
											1|[local::at0011], 	-- 41/min - 50/min or 101/min - 110/min
											2|[local::at0012], 	-- <= 40/min or 111/min - 129/min
											3|[local::at0013]  	-- >=130/min
										}
									}
									ELEMENT[at0014] occurrences matches {0..1} matches {	-- Systolic Blood Pressure
										value matches {
											0|[local::at0015], 	-- 101mmHg - 199mmHg
											1|[local::at0016], 	-- 81mmHg - 100mmHg
											2|[local::at0017], 	-- 71mmHg - 80mmHg or >200mmHg
											3|[local::at0018]  	-- <= 70mmHg
										}
									}
									ELEMENT[at0019] occurrences matches {0..1} matches {	-- Temperature
										value matches {
											0|[local::at0020], 	-- 36.1°C - 38°C
											1|[local::at0021], 	-- 35.1°C - 36°C or 38.1°C - 38.5°C
											2|[local::at0022]  	-- <= 35°C or > 38.5°C
										}
									}
									ELEMENT[at0023] occurrences matches {0..1} matches {	-- Level of consciousness
										value matches {
											0|[local::at0024], 	-- Alert
											1|[local::at0025], 	-- New confusion or Responds to voice
											2|[local::at0026], 	-- Responds to pain
											3|[local::at0027]  	-- Unconscious
										}
									}
									ELEMENT[at0028] occurrences matches {0..1} matches {	-- Urine output
										value matches {
											1|[local::at0029], 	-- Polyuria
											2|[local::at0030], 	-- Oliguria
											3|[local::at0031]  	-- Anuria
										}
									}
									ELEMENT[at0032] occurrences matches {0..1} matches {	-- Total score
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..17|}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

