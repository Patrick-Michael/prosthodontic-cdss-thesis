archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.stroke_case_study.v1

concept
	[at0000]	-- Stroke study
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2014-07-25">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the result from the execution of the stroke study guidelines.">
			use = <"Use only in relation to the stroke study. The information produced by the guidelines is the result of specific study criteria.">
			keywords = <"healthcare indicators", "stroke", "statins", "anticoagulants", "mortality">
			misuse = <"Do not use in other studies or context except in the case that the criteria are identical with those defined in the stroke study.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera resultatet från genomförandet av strokestudiens riktlinjer.">
			use = <"Används endast i samband med strokestudien. Den information som produceras av riktlinjerna är resultatet av särskilda studiekriterier.">
			keywords = <"öppna jämförelser", "stroke", "statiner", "antikoagulantia", "dödlighet">
			misuse = <"Används inte i andra studier eller sammanhang utom när kriterierna är identiska med dem som definieras i strokestudien.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"7DF9594465CAF3D1E2B29022400B2B91">
	>

definition
	OBSERVATION[at0000] matches {	-- Stroke study
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Statins in stroke
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- Absent
													at0006]	-- Present
												}
											}
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {	-- Anticoagulants in stroke
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- Absent
													at0006]	-- Present
												}
											}
										}
									}
									ELEMENT[at0008] occurrences matches {0..1} matches {	-- Stroke Mortality
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0009, 	-- Died within 28 days
													at0010, 	-- Died within 29-90 days
													at0011, 	-- Died after 90 days
													at0012]	-- Alive
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

