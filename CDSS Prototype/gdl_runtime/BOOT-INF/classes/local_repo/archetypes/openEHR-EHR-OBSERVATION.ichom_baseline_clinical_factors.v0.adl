archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.ichom_baseline_clinical_factors.v0

concept
	[at0000]	-- Ichom baseline clinical factors
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Blanca Flores">
		["organisation"] = <"Cambio Healthcare Systems">
		["email"] = <"blanca.flores@cambio.se">
		["date"] = <"2015-11-27">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To register baseline clinical factors for ICHOM data collection standards.">
			use = <"To register baseline clinical factors for ICHOM data collection standards. ">
			keywords = <"pulmonary function", "ICHOM", "comorbidities", "smoking", "weight loss">
			misuse = <"Do not use to register data outside the ICHOM measures.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["references"] = <"ICHOM Lung Cancer Data Collection Reference Guide. International Consortium for Health Outcome Measurement. Version 2.1. Revised April 24th, 2015.">
		["MD5-CAM-1.0.1"] = <"22D52DD6B59292F9E5B2BBDAFC343571">
	>

definition
	OBSERVATION[at0000] matches {	-- Ichom baseline clinical factors
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0005] occurrences matches {0..1} matches {	-- PULMFUNCPER
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0006, 	-- Higher than 79%
													at0007, 	-- 50% - 79%
													at0008, 	-- 30% - 49%
													at0009]	-- Less than 30%
												}
											}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {	-- PULMFUNCAB
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0011, 	-- 0 - 0.99 L
													at0012, 	-- 1.00 - 1.99 L
													at0013, 	-- 2.00 - 2.99 L
													at0014, 	-- 3.00 - 3.99 L
													at0015, 	-- 4.00 - 4.99 L
													at0016]	-- 5.00 - 5.99 L
												}
											}
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {	-- SMOKING
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0018, 	-- 1 = Never-smoker
													at0019, 	-- 2 = Ex-smoker
													at0020, 	-- 3 = Current smoker
													at0021]	-- 999 = Unknown
												}
											}
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {	-- COMORB
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0023, 	-- 0 = I have no other diseases
													at0024, 	-- 1 = Heart disease
													at0025, 	-- 2 = High blood pressure
													at0026, 	-- 3 = Leg pain when walking due to poor circulation
													at0027, 	-- 4 = Lung disease
													at0028, 	-- 5 = Diabetes
													at0029, 	-- 6 = Kidney disease
													at0030, 	-- 7 = Liver disease
													at0031, 	-- 8 = Problems caused by stroke
													at0032, 	-- 9 = Disease of the nervous system
													at0033, 	-- 10 = Other cancer (within the last 5 years)
													at0034, 	-- 11 = Depression
													at0035]	-- 12 = Arthritis
												}
											}
										}
									}
									ELEMENT[at0036] occurrences matches {0..1} matches {	-- WEIGHTL
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0037, 	-- 0 = No
													at0038, 	-- 1 = Yes
													at0039]	-- 999 = Unknown
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

