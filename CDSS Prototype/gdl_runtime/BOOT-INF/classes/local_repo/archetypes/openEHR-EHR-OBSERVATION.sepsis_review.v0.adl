archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.sepsis_review.v0

concept
	[at0000]	-- Sepsis review
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["organisation"] = <"Cambio Healthcare Systems">
		["name"] = <"Konstantinos Kalliamvakos">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To document a review of any possible sepsis condition of the subject of care ">
			use = <"">
			keywords = <"sepsis", "sepsis detection">
			misuse = <"">
			copyright = <"">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"*To document a review of any possible sepsis condition of the subject of care (en)">
			use = <"*(en)">
			misuse = <"*(en)">
			copyright = <"*(en)">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"318F489166A33E88151AEDF833E91F3E">
	>

definition
	OBSERVATION[at0000] matches {	-- Sepsis review
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0009] occurrences matches {0..1} matches {	-- Sepsis
										value matches {
											0|[local::at0011], 	-- Unlikely sepsis
											1|[local::at0012]  	-- Likely sepsis
										}
									}
									ELEMENT[at0039] occurrences matches {0..1} matches {	-- Infection data
										value matches {
											0|[local::at0040], 	-- PCT Absent
											1|[local::at0041], 	-- CRP Absent
											2|[local::at0048], 	-- CRP and PCT absent
											3|[local::at0049]  	-- No missing data
										}
									}
									ELEMENT[at0034] occurrences matches {0..1} matches {	-- CRP > 80
										value matches {
											0|[local::at0037], 	-- Absent
											1|[local::at0038]  	-- Present
										}
									}
									ELEMENT[at0033] occurrences matches {0..1} matches {	-- PCT > 2
										value matches {
											0|[local::at0035], 	-- Absent
											1|[local::at0036]  	-- Present
										}
									}
									ELEMENT[at0031] occurrences matches {0..1} matches {	-- CRP time
										value matches {
											DV_DATE_TIME matches {*}
										}
									}
									ELEMENT[at0032] occurrences matches {0..1} matches {	-- PCT time
										value matches {
											DV_DATE_TIME matches {*}
										}
									}
									ELEMENT[at0042] occurrences matches {0..1} matches {	-- Sepsis time
										value matches {
											DV_DATE_TIME matches {*}
										}
									}
									ELEMENT[at0020] occurrences matches {0..1} matches {	-- CRP
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::119]>
												list = <
													["1"] = <
														units = <"mg/l">
													>
												>
											>
										}
									}
									ELEMENT[at0021] occurrences matches {0..1} matches {	-- PCT
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::119]>
												list = <
													["1"] = <
														units = <"ug/l">
													>
												>
											>
										}
									}
									ELEMENT[at0043] occurrences matches {0..1} matches {	-- Responsible Unit
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0044, 	-- ICU
													at0045, 	-- Emergency Unit
													at0046, 	-- Other
													at0047]	-- Unknown
												}
											}
										}
									}
									ELEMENT[at0050] occurrences matches {0..1} matches {	-- Established sepsis diagnosis
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0051, 	-- Sepsis diagnosed and Sepsis CDS detected
													at0052, 	-- Sepsis diagnosed without Sepsis CDS detected
													at0053]	-- Sepsis CDS detected without Sepsis diagnosed
												}
											}
										}
									}
									ELEMENT[at0054] occurrences matches {0..1} matches {	-- Sepsis contact end time
										value matches {
											DV_DATE_TIME matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

