		["MD5-CAM-1.0.1"] = <"996811C36C022327FE399A3BEA574D88">
	>

definition
	EVALUATION[at0000] matches {	-- Risk stratification
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Index condition
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {	-- Significance of risk
						value matches {
							0|[local::at0004], 	-- Low risk
							1|[local::at0005], 	-- Low to moderate risk
							2|[local::at0006], 	-- Moderate risk
							3|[local::at0007], 	-- Moderate to high risk
							4|[local::at0008], 	-- High risk
							5|[local::at0009], 	-- High to very high risk
							6|[local::at0010]  	-- Very high risk
						}
					}
				}
			}
		}
	}

