	openEHR-EHR-EVALUATION.risk_stratification.v0

concept
	[at0000]	-- Risk stratification
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"">
	>
	details = <
		["en"] = <
