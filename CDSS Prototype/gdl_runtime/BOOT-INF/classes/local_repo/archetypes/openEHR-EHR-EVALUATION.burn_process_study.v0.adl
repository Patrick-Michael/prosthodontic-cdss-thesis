archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.burn_process_study.v0

concept
	[at0000]	-- Burn process study
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
