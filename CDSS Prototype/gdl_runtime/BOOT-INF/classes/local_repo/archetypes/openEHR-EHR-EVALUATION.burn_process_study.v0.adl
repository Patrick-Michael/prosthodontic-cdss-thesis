	original_author = <
		["name"] = <"Blanca Flores">
		["email"] = <"blanca.flores@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2016-01-14">
	>
	details = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera resultatet av brännskador process studien.">
			use = <"Används för att registrera data i Dashboard för brännskador studien processen.">
			keywords = <"VBH", "brännskador process">
			misuse = <"Används inte för att registrera data annat än brännskador processenen.
">
			copyright = <"Cambio Healthcare Systems">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the results for the burn process dashboard study.">
			use = <"Use to register patient data into Dashboard categories for the burn process case study.">
			keywords = <"VBH", "value based healthcare", "burn process">
			misuse = <"Do not use to register data for a process other than the burn process.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. Grundmall Jorunaltabell. (2009). Mallnamn: Bräannskador. Systemförvaltning EPJ.">
