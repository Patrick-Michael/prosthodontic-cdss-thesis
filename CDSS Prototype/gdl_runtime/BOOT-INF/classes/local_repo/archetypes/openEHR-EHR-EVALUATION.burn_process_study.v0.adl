	>

definition
	EVALUATION[at0000] matches {	-- Burn process study
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Lower extremities
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003, 	-- 0-10
									at0004, 	-- 11-20
									at0005, 	-- 21-30
									at0006]	-- 31-40
								}
							}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {	-- Shoulder-arm
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
