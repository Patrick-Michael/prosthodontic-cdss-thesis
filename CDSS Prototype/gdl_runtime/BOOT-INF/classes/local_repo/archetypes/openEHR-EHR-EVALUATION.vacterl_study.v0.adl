archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.vacterl_study.v0

concept
	[at0000]	-- Vacterl study
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["organisation"] = <"Cambio Healthcare Systems">
		["name"] = <"Joana Vicente">
		["email"] = <"joana.vicente@cambio.se">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To categorize values in the VACTERL process case study.">
			use = <"To categorize values in the VACTERL process case study.">
			keywords = <"VACTERL", "VBH", "value based healthcare">
			misuse = <"Do not use for categories of values other than the VACTERL process case study.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"Ange studie kategorier för VACTERL.">
			use = <"Ange kategorier för VACTERL process studie.">
			keywords = <"VACTERL", "värdebaserad sjukvård", "VBH">
			misuse = <"Används inte i annat studie än VACTERL.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"LUL, Systemförvaltning (2009). \"Mall för journaltabell Esofaguscancer\". Landstninget Uppsala Län">
		["MD5-CAM-1.0.1"] = <"C676880826406A94488B91A9CE9E95E5">
	>

definition
	EVALUATION[at0000] matches {	-- Vacterl study
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0003] occurrences matches {0..1} matches {	-- Esophagus
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0004] occurrences matches {0..1} matches {	-- Dysphagia sum categories
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0006, 	-- 6-12
											at0007, 	-- 13-18
											at0008, 	-- 19-24
											at0033, 	-- 25-30
											at0034]	-- 0-5
										}
									}
								}
							}
							ELEMENT[at0005] occurrences matches {0..1} matches {	-- Dysphagia sum
								value matches {
									DV_COUNT matches {*}
								}
							}
							ELEMENT[at0009] occurrences matches {0..1} matches {	-- De Meester score
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0010, 	-- Less or equal to 14,7
											at0011]	-- More than 14,7
										}
									}
								}
							}
						}
					}
					CLUSTER[at0012] occurrences matches {0..1} matches {	-- Lungs
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0013] occurrences matches {0..1} matches {	-- Pneumonia
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0014, 	-- 1
											at0015, 	-- 2
											at0016, 	-- 3
											at0017, 	-- 4
											at0018, 	-- 5
											at0019, 	-- 6
											at0020, 	-- 7
											at0021, 	-- 8
											at0022]	-- More than 9
										}
									}
								}
							}
						}
					}
					CLUSTER[at0023] occurrences matches {0..1} matches {	-- Bladder
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0024] occurrences matches {0..1} matches {	-- Urinary infection
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0014, 	-- 1
											at0015, 	-- 2
											at0016, 	-- 3
											at0017, 	-- 4
											at0018, 	-- 5
											at0019, 	-- 6
											at0020, 	-- 7
											at0021, 	-- 8
											at0022]	-- More than 9
										}
									}
								}
							}
						}
					}
					CLUSTER[at0025] occurrences matches {0..1} matches {	-- Parental survey
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0026] occurrences matches {0..1} matches {	-- Parental survey sum categories
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0027, 	-- 1-8
											at0028, 	-- 9-16
											at0029, 	-- 17-24
											at0030, 	-- 25-32
											at0031, 	-- 33-40
											at0032]	-- 41-48
										}
									}
								}
							}
							ELEMENT[at0035] occurrences matches {0..1} matches {	-- Parental survey sum
								value matches {
									DV_COUNT matches {
										magnitude matches {|8..48|}
									}
								}
							}
						}
					}
				}
			}
		}
	}

