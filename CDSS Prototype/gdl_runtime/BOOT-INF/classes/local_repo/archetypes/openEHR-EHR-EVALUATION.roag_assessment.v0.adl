archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.roag_assessment.v0

concept
	[at0000]	-- Roag Assessment
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"ROAG (Revised Oral  Assessment Guide) is a simple risk accessment instrument used to help to improve oral health in elderly.">
			use = <"Used to perform risk accessment of elderly oralt health. ROAG helps to identify oralt health problems in elderly and to access the eventual need for doctor/dentist consultation. ROAG provides an overview of the elderly´s individual need for oral health measures. ">
			keywords = <"ROAG", "Oral health", "elderly ">
			misuse = <"Do not use for other than oral health risk accessment in elderly. Do not use to evaluate the oral health status from a dentristry perspective. Does not replace dentists check ups. ">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"ROAG (Revised Oral  Assessment Guide) är ett enkelt riskbedömningsintrument för att förbättra munhälsan hos äldre. ">
			use = <"Används för att riskbedöma munhälsan hos äldre. ROAG identifiera problem i munhålan och utvärdera eventuellt behöv för remiss till läkare/tandläkare. ROAG tydliggör individuellt behöv av munvårdsåtgärder. ">
			keywords = <"ROAG", "munhälsa", "äldre ">
			misuse = <"Använda ej för annat munhälsan riskbedömning än hos äldre. Används ej för att utvärdera munhälsan status från ett tandvårdsperspektiv. Ersätter ej tanvårds undersökningen. ">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["references"] = <"Idwall E. Kvalitetsindikatorer inom omvårdnad. Gothia. 2013 
Wårdh I. Munhälsa. 2014:  hämtad from www.vårdhandboken.se November 2015. ">
		["MD5-CAM-1.0.1"] = <"1E22437494BAEFF14E1AAA272DAB93C8">
	>

definition
	EVALUATION[at0000] matches {	-- Roag Assessment
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0003] occurrences matches {0..1} matches {	-- Voice Recommendation
						value matches {
							0|[local::at0004], 	-- No action
							1|[local::at0005], 	-- Action
							2|[local::at0007]  	-- Action + referral
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {	-- Voice Action
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {[local::at0024]}		-- Moisten mouth
							}
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {	-- Lips Recommendation
						value matches {
							0|[local::at0033], 	-- No action
							1|[local::at0034], 	-- Action
							2|[local::at0035]  	-- Action + referral
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {	-- Lips Action
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0025, 	-- Lubricate lips
									at0057]	-- Local pain relief of lips
								}
							}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {	-- Mucous Membrane Recommendation
						value matches {
							0|[local::at0036], 	-- No action
							1|[local::at0037], 	-- Action
							2|[local::at0038]  	-- Action + referral
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {	-- Mucous Membrane Action
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0026, 	-- Clean and lubricate mucous membrane
									at0058, 	-- Removal of scabs
									at0059]	-- Local pain relief of mucous membrane
								}
							}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {	-- Tongue Recommendation
						value matches {
							0|[local::at0039], 	-- No action
							1|[local::at0040], 	-- Action
							2|[local::at0041]  	-- Action + referral
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {	-- Tongue Action
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0027, 	-- Clean tongue
									at0060, 	-- Moisten tongue
									at0061]	-- Local pain relief of tongue
								}
							}
						}
					}
					ELEMENT[at0014] occurrences matches {0..1} matches {	-- Gums Recommendation
						value matches {
							0|[local::at0042], 	-- No action
							1|[local::at0043], 	-- Action
							2|[local::at0044]  	-- Action + referral
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {	-- Gums Action
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0069, 	-- Brush teeth
									at0028, 	-- Information and/or training regarding oral care in order for the patient to conduct oral care independently
									at0070, 	-- Cleanse area between teeth
									at0071, 	-- Clean mouth with foam rubber
									at0072, 	-- Fluorine supplement in addition to tooth paste containing fluorine
									at0073]	-- Additional oral care if patient is on enhanced diet
								}
							}
						}
					}
					ELEMENT[at0016] occurrences matches {0..1} matches {	-- Teeth/dentures Recommendation
						value matches {
							0|[local::at0045], 	-- No action
							1|[local::at0046], 	-- Action
							2|[local::at0047]  	-- Action + referral
						}
					}
					ELEMENT[at0017] occurrences matches {0..1} matches {	-- Teeth/dentures Action
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0029, 	-- Brush teeth
									at0064, 	-- Information and/or training regarding oral care in order for the patient to conduct oral care independently
									at0065, 	-- Cleanse area between teeth
									at0066, 	-- Clean mouth with foam rubber
									at0067, 	-- Fluorine supplement in addition to tooth paste containing fluorine
									at0068]	-- Additional oral care if patient is on enhanced diet
								}
							}
						}
					}
					ELEMENT[at0018] occurrences matches {0..1} matches {	-- Prosthesis Recommendation
						value matches {
							0|[local::at0048], 	-- No action
							1|[local::at0049], 	-- Action
							2|[local::at0050]  	-- Action + referral
						}
					}
					ELEMENT[at0019] occurrences matches {0..1} matches {	-- Prosthesis Action
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0030, 	-- Information and/or training regarding oral care in order for the patient to conduct oral care/cleansing of prosthesis independently
									at0062, 	-- Clean prosthesis
									at0063]	-- Clean the remaining teeth and gums
								}
							}
						}
					}
					ELEMENT[at0020] occurrences matches {0..1} matches {	-- Saliva Recommendation
						value matches {
							0|[local::at0051], 	-- No action
							1|[local::at0052], 	-- Action
							2|[local::at0053]  	-- Action + referral
						}
					}
					ELEMENT[at0021] occurrences matches {0..1} matches {	-- Saliva Action
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {[local::at0031]}		-- Moisten mucous membrane
							}
						}
					}
					ELEMENT[at0022] occurrences matches {0..1} matches {	-- Swallowing Recommendation
						value matches {
							0|[local::at0054], 	-- No action
							1|[local::at0055], 	-- Action
							2|[local::at0056]  	-- Action + referral
						}
					}
					ELEMENT[at0023] occurrences matches {0..1} matches {	-- Swallowing Action
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {[local::at0032]}		-- Alleviate swallowing by moistening the mouth
							}
						}
					}
				}
			}
		}
	}

