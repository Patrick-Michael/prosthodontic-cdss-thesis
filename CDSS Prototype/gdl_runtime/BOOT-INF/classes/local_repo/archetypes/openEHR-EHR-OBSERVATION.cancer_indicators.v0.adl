archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.cancer_indicators.v0

concept
	[at0000]	-- Cancer indicators
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["organisation"] = <"Cambio Healthcare Systems">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["date"] = <"2014-11-25">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record information for indicating important aspects of a cancer process">
			use = <"">
			keywords = <"cancer", "process", "indicators">
			misuse = <"">
			copyright = <"">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"03EB9CD784719FC272D403E4EB21D675">
	>

definition
	OBSERVATION[at0000] matches {	-- Cancer indicators
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Multidisciplinary state
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- Pre-MDT
													at0006]	-- Post-MDT
												}
											}
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {	-- Pre-MDT Treatment intent
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0008, 	-- Curative
													at0009]	-- Palliative
												}
											}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {	-- Pre-MDT Radiotherapy
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0011, 	-- Yes
													at0012, 	-- No
													at0013]	-- Neoadjuvant
												}
											}
										}
									}
									ELEMENT[at0014] occurrences matches {0..1} matches {	-- Pre-MDT Antitumoral treatment
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0015, 	-- Yes
													at0016, 	-- No
													at0017]	-- Palliative
												}
											}
										}
									}
									ELEMENT[at0018] occurrences matches {0..1} matches {	-- Surgery
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0019, 	-- Yes
													at0020]	-- No
												}
											}
										}
									}
									ELEMENT[at0021] occurrences matches {0..1} matches {	-- Operation performed
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0022, 	-- Yes
													at0023]	-- No
												}
											}
										}
									}
									ELEMENT[at0024] occurrences matches {0..1} matches {	-- Wait and assess
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0025, 	-- Yes
													at0026]	-- No
												}
											}
										}
									}
									ELEMENT[at0027] occurrences matches {0..1} matches {	-- Post-MDT Treatment intent
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0028, 	-- Curative
													at0029]	-- Palliative
												}
											}
										}
									}
									ELEMENT[at0030] occurrences matches {0..1} matches {	-- Post-MDT Antitumoral treatment
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0031, 	-- Yes
													at0032, 	-- No
													at0033]	-- Palliative
												}
											}
										}
									}
									ELEMENT[at0034] occurrences matches {0..1} matches {	-- Post-MDT Radiotherapy
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0035, 	-- Yes
													at0036, 	-- No
													at0037]	-- Neoadjuvant
												}
											}
										}
									}
									ELEMENT[at0038] occurrences matches {0..1} matches {	-- Patient state
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0039, 	-- Operation
													at0040, 	-- Follow-up
													at0041, 	-- Adjuvant
													at0042, 	-- Palliative
													at0043, 	-- Palliative-antitumoral
													at0044, 	-- Neoadjuvant
													at0045]	-- Post-operative
												}
											}
										}
									}
									ELEMENT[at0046] occurrences matches {0..1} matches {	-- Diagnosis to treatment time
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0047, 	-- 0-25 days
													at0048, 	-- 26-50 days
													at0049]	-- 51-100 days
												}
											}
										}
									}
									ELEMENT[at0050] occurrences matches {0..1} matches {	-- Operation to adjuvant chemotherapy time
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0051, 	-- 0-25 days
													at0052, 	-- 26-50 days
													at0053]	-- 51-100 days
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

