archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.vacterl_intestinal.v0

concept
	[at0000]	-- Vacterl intestinal
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["organisation"] = <"Cambio Healthcare Systems">
		["name"] = <"Joana Vicente">
		["email"] = <"joana.vicente@cambio.se">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record patient information for birth defects VACTERL instestinal.Clinical relevant data is registered throught this archetype.">
			use = <"Use for patients with instestinal problems and birth defects VACTERL.">
			keywords = <"VACTERL", "soiling", "constipation", "faeces control", "gas incontinence", "intestinal", "VBH", "value based healthcare">
			misuse = <"Do not use for other than to register patient data related to VACTERL sindrome and related instestinal problems.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera patient data för tarm relaterad till VACTERL syndrom. Klinisk data registreras i denna archetype.">
			use = <"Används för patienter med VACTERL syndrom och tarmproblem.">
			keywords = <"VACTERL", "soiling", "avföringskontroll", "förstoppning", "gasinkontinens", "förstoppningsbehandling", "VBH", "value based healthcare">
			misuse = <"Används inte för annat än för att registrera information för med VACTERL syndrom och tarmproblem.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. LUL, Systemförvaltning (2009). \"Grundmall KB Esofagusatresi, analatresi, VACTERL\". Landstninget Uppsala Län.">
		["MD5-CAM-1.0.1"] = <"1AD89795867F07BC2495973B4AC94D2E">
	>

definition
	EVALUATION[at0000] matches {	-- Vacterl intestinal
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Review date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {	-- Faeces control
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0004, 	-- Yes
									at0005]	-- No
								}
							}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {	-- Soiling
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0007, 	-- Grade 1 - (1-2 times a week)
									at0008, 	-- Grade 2 - (everyday, no soc)
									at0009, 	-- Grade 3 - (always, soc)
									at0010]	-- No
								}
							}
						}
					}
					CLUSTER[at0011] occurrences matches {0..1} matches {	-- Constipation
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0012] occurrences matches {0..1} matches {	-- Constipation grade
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0013, 	-- Grade 1 - Diet
											at0014, 	-- Grade 2 - Laxatives
											at0015, 	-- Grade 3 - Laxatives not sufficient
											at0016]	-- No
										}
									}
								}
							}
							ELEMENT[at0017] occurrences matches {0..1} matches {	-- Constipation treatment
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0018, 	-- Bowel irritant (Laxoberal)
											at0019, 	-- Osmotic (Lactulose, Forlax, Importal, Movicol)
											at0020]	-- Klysma (Klyx, Microlax, Resulax, Toilax)
										}
									}
								}
							}
						}
					}
					ELEMENT[at0021] occurrences matches {0..1} matches {	-- Gas incontinence
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0022, 	-- Yes
									at0023]	-- No
								}
							}
						}
					}
				}
			}
		}
	}

