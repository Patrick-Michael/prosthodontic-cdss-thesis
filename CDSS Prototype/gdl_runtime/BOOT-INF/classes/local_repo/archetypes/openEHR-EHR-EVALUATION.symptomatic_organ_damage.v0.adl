archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.symptomatic_organ_damage.v0

concept
	[at0000]	-- Established cv or renal disease
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"">
			use = <"">
			misuse = <"">
			copyright = <"">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["MD5-CAM-1.0.1"] = <"0A131A1D4E30ACDF2909842E1B010C98">
	>

definition
	EVALUATION[at0000] matches {	-- Established cv or renal disease
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Cerebrovascular disease
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {	-- Coronary heart disease
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {	-- Heart failure
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {	-- Symptomatic lower extremities peripheral artery disease
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {	-- Advanced retinopathy
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {	-- CKD stage 4 or 5
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {	-- Symptomatic CVD or renal disease
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {	-- Total CVD or renal disease
						value matches {
							DV_COUNT matches {
								magnitude matches {|>=0|}
							}
						}
					}
				}
			}
		}
	}

