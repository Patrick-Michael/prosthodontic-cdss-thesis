archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.sirs_summary.v0

concept
	[at0000]	-- Sirs summary
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["organisation"] = <"Cambio Healthcare Systems">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["date"] = <"2013-12-18">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"For evaluating the SIRS criteria on a patient">
			use = <"">
			keywords = <"sepsis", "systemic inflammatory response syndrome", "SIRS">
			misuse = <"">
			copyright = <"">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. Brink M, Cronqvist J, Furebring M, Gårdlund B, Lanbeck P, Ljungström L, et al. Vårdprogram Svår sepsis och septisk chock - tidig identifiering och initial handläggning. Svenska Infektionsläkarföreningen; 2013.">
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"01E755415850057F5F7CDF4F8BB38057">
	>

definition
	EVALUATION[at0000] matches {	-- Sirs summary
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- SIRS
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003, 	-- Absent
									at0004]	-- Present
								}
							}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {	-- Date (time) of SIRS
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {	-- Number of SIRS events
						value matches {
							DV_COUNT matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {	-- Temperature >38°C or < 36°C
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0008, 	-- Absent
									at0009]	-- Present
								}
							}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {	-- Heart rate > 90 /min
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0014, 	-- Absent
									at0015]	-- Present
								}
							}
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {	-- PaCO2 < 4.3 kPa
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0016, 	-- Absent
									at0017]	-- Present
								}
							}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {	-- Respiratory rate > 20/min
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0018, 	-- Absent
									at0019]	-- Present
								}
							}
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {	-- WBC < 4 10*9/L or >12 10*9/L
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0020, 	-- Absent
									at0021]	-- Present
								}
							}
						}
					}
				}
			}
		}
	}

