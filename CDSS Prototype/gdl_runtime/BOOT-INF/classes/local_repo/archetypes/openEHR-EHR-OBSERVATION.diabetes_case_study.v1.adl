archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.diabetes_case_study.v1

concept
	[at0000]	-- Diabetes study
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2014-07-25">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the result from the execution of the diabetes study guidelines.">
			use = <"Use only in relation to the diabetes study. The information produced by the guidelines is the result of specific study criteria.">
			keywords = <"healthcare indicators", "blood pressure", "diabetes", "length of stay", "hospitalization", "HbA1c", "cholesterol", "low density lipoprotein", "LDL cholesterol">
			misuse = <"Do not use in other studies or context except in the case that the criteria are identical with those defined in the diabetes study.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera resultatet från genomförandet av diabetesstudiens riktlinjer.">
			use = <"Används endast i samband med Diabetesstudien. Den information som produceras av riktlinjerna är resultatet av särskilda studiekriterier.">
			keywords = <"öppna jämförelser", "blodtryck", "diabetes", "vårdtid", "sjukhusvård", "HbA1c", "kolesterol", "low density lipoprotein", "LDL-kolesterol">
			misuse = <"Används inte i andra studier eller sammanhang utom när kriterierna är identiska med dem som definieras i diabetesstudien.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. Socialstyrelsen. Öppna jämförelser 2013 – Hälso- och sjukvård – Jämförelser mellan landsting. Västerås: Edita Västra Aros AB; 2013.
2. Socialstyrelsen. Bilaga 1 Beskrivning av indikatorer- Öppna jämförelser 2013: Hälso och sjukvård. 2013.">
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"5445E252B882C5263BC1BE9F0E316B1B">
	>

definition
	OBSERVATION[at0000] matches {	-- Diabetes study
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Glycated hemoglobin
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- <= 52 mmol/mol
													at0006, 	-- 53-62 mmol/mol
													at0007, 	-- 63-72 mmol/mol
													at0008]	-- > 72 mmol/mol
												}
											}
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {	-- Blood pressure - Systolic
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0010, 	-- <= 130 mmHg
													at0011, 	-- 131-140 mmHg
													at0012, 	-- 141-150 mmHg
													at0013, 	-- 151-160 mmHg
													at0014]	-- > 160 mmHg
												}
											}
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {	-- Blood pressure - Diastolic
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0016, 	-- <= 80 mmHg
													at0017, 	-- 81-90 mmHg
													at0018, 	-- 91-100 mmHg
													at0019, 	-- 101-110 mmHg
													at0020]	-- > 110 mmHg
												}
											}
										}
									}
									ELEMENT[at0021] occurrences matches {0..1} matches {	-- LDL Cholesterol
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0022, 	-- <= 2.5 mmol/L
													at0023, 	-- 2.6-3.5 mmol/L
													at0024, 	-- 3.6-4.5 mmol/L
													at0025]	-- > 4.5 mmol/L
												}
											}
										}
									}
									ELEMENT[at0026] occurrences matches {0..1} matches {	-- Diabetes patients that got hospitalized within the last 12 months
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0027, 	-- Absent
													at0028]	-- Present
												}
											}
										}
									}
									ELEMENT[at0029] occurrences matches {0..1} matches {	-- Number of hospitalized days for patients with diabetes
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0030, 	-- < 3 days
													at0031, 	-- 3-5 days
													at0032, 	-- 6-10 days
													at0033, 	-- 11-20 days
													at0034, 	-- 21-30 days
													at0035]	-- > 30 days
												}
											}
										}
									}
									ELEMENT[at0036] occurrences matches {0..1} matches {	-- Length of stay
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::128]>
												list = <
													["1"] = <
														units = <"d">
													>
													["2"] = <
														units = <"millisec">
													>
												>
											>
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

