archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.esophagus_cancer_study.v0

concept
	[at0000]	-- Esophagus cancer study
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Joana Vicente">
		["email"] = <"joana.vicente@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
	>
	details = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att presentera patient data som används inom värdebaserad sjukvård studie för esofaguscancer. Anger kategorier for studiernas indikatorer.">
			use = <"För att presentera patientens rapporterad information samt klinisk data för värdebaserad sjukvårds studie esofaguscancer.">
			keywords = <"VBH", "värdebaserad sjukvård", "esofaguscancer", "kardiacancer", "cancer">
			misuse = <"Används inte för annat studie än esofaguscancer.">
			copyright = <"Cambio Healthcare Systems">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To present data related to the value based healthcare study for esophagus cancer. Aggregates the categories for the studies indicators.">
			use = <"To present patient own reported and clinical data related to the value based healthcare study for esophagus cancer.">
			keywords = <"VBH", "value based healthcare", "esophagus cancer", "cardia cancer", "cancer">
			misuse = <"Do not use of other studies other than esophagus cancer.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"LUL, Systemförvaltning (2009). \"Mall för journaltabell Esofaguscancer\". Landstninget Uppsala Län">
		["MD5-CAM-1.0.1"] = <"D223576FFFB33CE9C841DD0B21B8CBCE">
	>

definition
	EVALUATION[at0000] matches {	-- Esophagus cancer study
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0002] occurrences matches {0..1} matches {	-- Weight and eating problems
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0003] occurrences matches {0..1} matches {	-- Latest weight
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0004, 	-- Less than 50
											at0005, 	-- 50 - 65.9 kg
											at0006, 	-- 66 - 80 kg
											at0007]	-- Higher than 80 kg
										}
									}
								}
							}
							ELEMENT[at0008] occurrences matches {0..1} matches {	-- Body Mass Index
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0009, 	-- Less than 18.5 kg/m2
											at0010, 	-- 18.5 - 24.9 kg/m2
											at0011, 	-- 25 - 29.9 kg/m2
											at0012, 	-- 30 - 35 kg/m2
											at0013]	-- Higher than 35 kg/m2
										}
									}
								}
							}
							ELEMENT[at0014] occurrences matches {0..1} matches {	-- Height
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0015, 	-- Less than 150 cm
											at0016, 	-- 150 - 169.9 cm
											at0017, 	-- 170 - 190 cm
											at0018]	-- Higher than 190 cm
										}
									}
								}
							}
							ELEMENT[at0019] occurrences matches {0..1} matches {	-- Weight before surgery
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0020, 	-- Less than 50 kg
											at0021, 	-- 50 - 65.9 kg
											at0022, 	-- 66 - 80 kg
											at0023]	-- Higher than 80 kg
										}
									}
								}
							}
							ELEMENT[at0024] occurrences matches {0..1} matches {	-- Weight loss from normal weight
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0025, 	-- Under 5%
											at0026, 	-- 5-10%
											at0027]	-- Higher than 10%
										}
									}
								}
							}
						}
					}
					CLUSTER[at0028] occurrences matches {0..1} matches {	-- Fatigue
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0029] occurrences matches {0..1} matches {	-- MFI-20 general fatigue
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0030, 	-- 0-5
											at0031, 	-- 6-10
											at0032, 	-- 11-15
											at0033]	-- 16-20
										}
									}
								}
							}
							ELEMENT[at0034] occurrences matches {0..1} matches {	-- MFI-20 mental fatigue
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0035, 	-- 0-5
											at0036, 	-- 6-10
											at0037, 	-- 11-15
											at0038]	-- 16-20
										}
									}
								}
							}
							ELEMENT[at0039] occurrences matches {0..1} matches {	-- MFI-20 reduced motivation
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0030, 	-- 0-5
											at0031, 	-- 6-10
											at0032, 	-- 11-15
											at0033]	-- 16-20
										}
									}
								}
							}
							ELEMENT[at0040] occurrences matches {0..1} matches {	-- MFI-20 reduced activity
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0035, 	-- 0-5
											at0036, 	-- 6-10
											at0037, 	-- 11-15
											at0038]	-- 16-20
										}
									}
								}
							}
							ELEMENT[at0041] occurrences matches {0..1} matches {	-- MFI-20 physical fatigue
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0035, 	-- 0-5
											at0036, 	-- 6-10
											at0037, 	-- 11-15
											at0038]	-- 16-20
										}
									}
								}
							}
						}
					}
					CLUSTER[at0042] occurrences matches {0..1} matches {	-- Physical activity
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0043] occurrences matches {0..1} matches {	-- Everyday exercise
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0044, 	-- Less than 30 min/wk
											at0045, 	-- 30 - 60 min/wk
											at0046, 	-- 61 - 180 min/wk
											at0047, 	-- 181 - 420 min/wk
											at0048]	-- More than 420 min/wk
										}
									}
								}
							}
							ELEMENT[at0049] occurrences matches {0..1} matches {	-- Physical training
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0050, 	-- Less than 30 min/wk
											at0051, 	-- 30 - 60 min/wk
											at0052, 	-- 61 - 180 min/wk
											at0053, 	-- 181 - 420 min/wk
											at0054]	-- More than 420 min/wk
										}
									}
								}
							}
							ELEMENT[at0055] occurrences matches {0..1} matches {	-- Timed stands
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0056, 	-- 0-10 sec
											at0057, 	-- 11-20 sec
											at0058, 	-- 21-30 sec
											at0059, 	-- 31-40 sec
											at0060, 	-- 41-50 sec
											at0061]	-- 51-60 sec
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

