archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.svf_cancer_categories_kva.v0

concept
	[at0000]	-- Svf cancer categories KVA
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Joana Vicente">
		["email"] = <"joana.vicente@cambio.se">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Set Dashboard categories for SVF prostata cancer case study.">
			use = <"Use to register patient data into Dashboard categories for the SVF prostata cancer case study.
">
			keywords = <"SVF", "prostate ", "cancer ", "kva">
			misuse = <"Do not use to register data for a process other than  the SVF prostata cancer case study.
">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"Ange Dashboard kategorier för svf cancer processen enligt kva koder. Ett initialt studie om svf cancer.">
			use = <"För att registrera data för Dashboard studie  för svf cancer processen enligt kva koder. Ett initialt studie om svf cancer.">
			keywords = <"SVF", "KVA", "cancer">
			misuse = <"Används ej för annat än för att registrera data för Dashboard studie  för svf cancer processen enligt kva koder. Ett initialt studie om svf cancer.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["references"] = <"Socialstyrelsen (2015). Standardiserade vårdförlopp i cancervården. En baslinjestudie. Hämtad från https://www.socialstyrelsen.se/Lists/Artikelkatalog/Attachments/19926/2015-10-5.pdf Februari 2016. 
Regionala Cancercentrum i Samverkan (2016).Prostatacancer Primärvårdsversion av standardiseradt vårdförlopp 2016. Hämtad från http://www.cancercentrum.se/globalassets/vara-uppdrag/kunskapsstyrning/varje-dag-raknas/vardforlopp/primarvardsversioner_standardiserade_vardforlopp_20151221.pdf Februari 2016. ">
		["MD5-CAM-1.0.1"] = <"22822A1BDB1C533770824F53490904D5">
	>

definition
	OBSERVATION[at0000] matches {	-- Svf cancer categories KVA
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- VP915 – Referal received at specialist care
