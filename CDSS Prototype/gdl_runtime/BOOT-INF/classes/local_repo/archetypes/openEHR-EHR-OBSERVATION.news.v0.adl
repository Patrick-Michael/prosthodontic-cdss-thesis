archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.news.v0

concept
	[at0000]	-- NEWS
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["organisation"] = <"Cambio Healthcare Systems">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["date"] = <"2014-10-23">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"NEWS is used as a surveillance system for all patients in hospitals, tracking their clinical condition, alerting the clinical team to any clinical deterioration and triggering a timely clinical response.">
			use = <"Use to record a score to quicly determine the degree of illness of a patient">
			keywords = <"early warning", "national early warning score", "NEWS">
			misuse = <"Not to be used to record Modified Early Warning Score (MEWS). Use openEHR-EHR-OBSERVATION.mews.v1">
			copyright = <"">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. Royal College of Physicians. National Early Warning Score (NEWS): Standardising the assessment of acute illness severity in the NHS. London:: RCP; 2012.">
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"717A5DDFC69D1E5A1AE9B1594FE7FFD9">
	>

definition
	OBSERVATION[at0000] matches {	-- NEWS
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Respiration Rate
										value matches {
											0|[local::at0005], 	-- 12/min - 20/min
											1|[local::at0006], 	-- 9/min - 11/min
											2|[local::at0007], 	-- 21/min - 24/min
											3|[local::at0008]  	-- <= 8/min or >= 25/min
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {	-- Oxygen Saturations
										value matches {
											0|[local::at0010], 	-- >= 96%
											1|[local::at0011], 	-- 94% - 95%
											2|[local::at0012], 	-- 92% - 93%
											3|[local::at0013]  	-- <= 91%
										}
									}
									ELEMENT[at0014] occurrences matches {0..1} matches {	-- Any supplemental Oxygen
										value matches {
											0|[local::at0015], 	-- No
											2|[local::at0016]  	-- Yes
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {	-- Temperature
										value matches {
											0|[local::at0018], 	-- 36.1°C - 38.0°C
											1|[local::at0019], 	-- 35.1°C - 36.0°C or 38.1°C - 39.0°C
											2|[local::at0020], 	-- >= 39.1°C
											3|[local::at0021]  	-- <= 35.0°C
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {	-- Systolic Blood Pressure
										value matches {
											0|[local::at0023], 	-- 111mmHg - 219mmHg
											1|[local::at0024], 	-- 101mmHg - 110mmHg
											2|[local::at0025], 	-- 91mmHg - 100mmHg
											3|[local::at0026]  	-- <= 90mmHg or >= 220mmHg
										}
									}
									ELEMENT[at0027] occurrences matches {0..1} matches {	-- Heart Rate
										value matches {
											0|[local::at0028], 	-- 51/min - 90/min
											1|[local::at0029], 	-- 41/min - 50/min or 91/min - 110/min
											2|[local::at0030], 	-- 111/min - 130/min
											3|[local::at0031]  	-- <= 40/min or >= 131/min
										}
									}
									ELEMENT[at0032] occurrences matches {0..1} matches {	-- Level of Consciousness
										value matches {
											0|[local::at0033], 	-- A
											3|[local::at0034]  	-- V, P or U
										}
									}
									ELEMENT[at0035] occurrences matches {0..1} matches {	-- Total score
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..20|}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

