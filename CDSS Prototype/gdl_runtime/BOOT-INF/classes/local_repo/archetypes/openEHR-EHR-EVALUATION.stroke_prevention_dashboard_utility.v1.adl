archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.stroke_prevention_dashboard_utility.v1

concept
	[at0000]	-- Stroke prevention dashboard utility
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2014-04-14">
	>
	details = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera specifik information för specifikationerna av Stroke prevention studien som inte ingår i de primära Stroke prevention riktlinjerna.">
			use = <"Används endast i samband med Stroke preventionsstudien. Den information som produceras av riktlinjerna är resultatet av särskilda studiekriterier.">
			keywords = <"CHA2DS2-VASc", "stroke", "profylax", "förmaksflimmer", "blödning">
			misuse = <"Används inte i andra studier eller sammanhang utom då kriterierna är identiska med dem som definieras i Stroke prevention studien.">
			copyright = <"Cambio Healthcare Systems">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record specific information for the needs of the stroke prevention study that are not part of the main stroke prevention guidelines.">
			use = <"Use only in relation to the stroke prevention study. The information produced by the guidelines is the result of specific study criteria.">
			keywords = <"CHA2DS2-VASc", "stroke", "prevention", "atrial fibrillation", "bleeding">
			misuse = <"Do not use in other studies or context except in the case that the criteria are identical with those defined in the stroke prevention study.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"CE26AE5244BB9DA2390D2D5D1C650054">
	>

definition
	EVALUATION[at0000] matches {	-- Stroke prevention dashboard utility
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0007] occurrences matches {0..1} matches {	-- Decision postponed
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0045, 	-- 1 day
									at0017, 	-- 7 days
									at0018, 	-- 30 days
									at0019]	-- 365 days
								}
							}
						}
					}
					ELEMENT[at0034] occurrences matches {0..1} matches {	-- CHA2DS2-VASc score
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0035, 	-- 0
									at0036, 	-- 1
									at0037, 	-- 2
									at0038, 	-- 3
									at0039, 	-- 4
									at0040, 	-- 5
									at0041, 	-- 6
									at0042, 	-- 7
									at0043, 	-- 8
									at0044]	-- 9
								}
							}
						}
					}
					CLUSTER[at0024] occurrences matches {0..1} matches {	-- Override
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0033] occurrences matches {0..1} matches {	-- General diagnosis override
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0031, 	-- Diagnosis not changed
											at0032]	-- Diagnosis changed
										}
									}
								}
							}
							ELEMENT[at0025] occurrences matches {0..1} matches {	-- Atrial fibrillation override
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0031, 	-- Diagnosis not changed
											at0032]	-- Diagnosis changed
										}
									}
								}
							}
							ELEMENT[at0026] occurrences matches {0..1} matches {	-- Diabetes override
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0031, 	-- Diagnosis not changed
											at0032]	-- Diagnosis changed
										}
									}
								}
							}
							ELEMENT[at0027] occurrences matches {0..1} matches {	-- Hypertension override
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0031, 	-- Diagnosis not changed
											at0032]	-- Diagnosis changed
										}
									}
								}
							}
							ELEMENT[at0028] occurrences matches {0..1} matches {	-- Congestive heart failure override
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0031, 	-- Diagnosis not changed
											at0032]	-- Diagnosis changed
										}
									}
								}
							}
							ELEMENT[at0029] occurrences matches {0..1} matches {	-- Stroke/TIA/Thromboembolism override
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0031, 	-- Diagnosis not changed
											at0032]	-- Diagnosis changed
										}
									}
								}
							}
							ELEMENT[at0030] occurrences matches {0..1} matches {	-- Vascular disease override
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0031, 	-- Diagnosis not changed
											at0032]	-- Diagnosis changed
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

