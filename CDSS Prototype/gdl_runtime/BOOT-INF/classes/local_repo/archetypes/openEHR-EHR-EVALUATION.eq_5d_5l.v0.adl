archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.eq_5d_5l.v0

concept
	[at0000]	-- EQ-5D-5L Health status
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Joana Vicente">
		["email"] = <"joana.vicente@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems ">
		["date"] = <"2016-01-14">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To provide a simple standardized, generic measure of health status for clinical and economic appraisal based on the EQ-5D-5L measure developed by the EuroQol Group. [1]">
			use = <"Use for a wide range of health conditions and treatments, it provides a simple descriptive profile and a single index value for health status that can be used in the clinical and economic evaluation of health care as well as in population health surveys.
EQ-5D is designed for self-completion by respondents and is ideally suited for use in postal surveys, in clinics, and in face-to-face interviews. [1]">
			keywords = <"health status", "eq-5d-5l", "VBH", "value based healthcare">
			misuse = <"Do not use for recording information related to  EQ-5D-3L. That should be done with another archetype dedicated for EQ-5D-3L.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att ge ett enkelt standardiserat mått på hälsan för ekonomiska och kliniska användningar, baserad på EQ-5D-5L mått som utvecklats av EuroQol Group. [1]">
			use = <"Används för ett brett spektrum av sjukdomar och behandlingar. Den tillhandahåller en enkel beskrivande profil och ett indexvärde för hälsotillståndet som kan användas i den kliniska och ekonomiska utvärderingen. Även inom vården samt för befolknings- hälsoundersökningar.
EQ-5D är utformad så den tillfrågade  kan fylla i enkäten själv, den är idealisk för användning i postenkäter, på kliniker och i  patientintervjuer. [1]">
			keywords = <"hälsa", "status", "eq-5d-5l", "VBH">
			misuse = <"Används inte för att registrera information relaterad till EQ-5D-3L. De ska göra med en andra arketyp dedikerad för EQ-5D-3L.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <"Blanca Flores", ...>
	other_details = <
		["references"] = <"1. The EuroQol Group (1990). EuroQol-a new facility for the measurement of health-related quality of life. Health Policy 16(3):199-208.">
		["MD5-CAM-1.0.1"] = <"9D307112C4902882A77BE55D77AEE54A">
	>

definition
	EVALUATION[at0000] matches {	-- EQ-5D-5L Health status
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Mobility
						value matches {
							1|[local::at0003], 	-- No problems
							2|[local::at0004], 	-- Slight problems
							3|[local::at0005], 	-- Moderate problems
							4|[local::at0006], 	-- Severe problems
							5|[local::at0007]  	-- Unable to walk about
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {	-- Self-care
						value matches {
							1|[local::at0009], 	-- No problems
							2|[local::at0011], 	-- Slight problems
							3|[local::at0012], 	-- Moderate problems
							4|[local::at0013], 	-- Severe problems
							5|[local::at0014]  	-- Unable to wash or dress
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {	-- Usual activities
						value matches {
							1|[local::at0016], 	-- No problems
							2|[local::at0017], 	-- Slight problems
							3|[local::at0018], 	-- Moderate problems
							4|[local::at0019], 	-- Severe problems
							5|[local::at0020]  	-- Unable to do my usual activities
						}
					}
					ELEMENT[at0021] occurrences matches {0..1} matches {	-- Pain/discomfort
						value matches {
							1|[local::at0022], 	-- No pain or discomfort
							2|[local::at0023], 	-- Slight pain or discomfort
							3|[local::at0024], 	-- Moderate pain or discomfort
							4|[local::at0025], 	-- Severe pain or discomfort
							5|[local::at0026]  	-- Extreme pain or discomfort
						}
					}
					ELEMENT[at0027] occurrences matches {0..1} matches {	-- Anxiety/depression
						value matches {
							1|[local::at0028], 	-- No anxiety or depression
							2|[local::at0029], 	-- Slight anxiety or depression
							3|[local::at0030], 	-- Moderate anxiety or depression
							4|[local::at0031], 	-- Severe anxiety or depression
							5|[local::at0032]  	-- Extreme anxiety or depression
						}
					}
					ELEMENT[at0033] occurrences matches {0..1} matches {	-- Overall health
						value matches {
							DV_COUNT matches {
								magnitude matches {|0..100|}
							}
						}
					}
					ELEMENT[at0034] occurrences matches {0..1} matches {	-- EQ-5D-5L date (time)
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
				}
			}
		}
	}

