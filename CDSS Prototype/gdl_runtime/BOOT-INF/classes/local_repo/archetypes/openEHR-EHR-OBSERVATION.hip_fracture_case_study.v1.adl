archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.hip_fracture_case_study.v1

concept
	[at0000]	-- Hip fracture study
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2014-07-25">
	>
	details = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera resultatet vid körning av höftfrakturstudiens riktlinjer.">
			use = <"Används endast i samband med höftfrakturstudien. Den information som produceras av riktlinjerna är resultatet av särskilda studiekriterier.">
			keywords = <"öppna jämförelser", "dödlighet", "höftfraktur", "protesoperation", "operation", "osteosyntes", "ledprotes", "Socialstyrelsen", "väntetid">
			misuse = <"Används inte i andra studier eller sammanhang utom när kriterierna är identiska med dem som definieras i höftfrakturstudien.">
			copyright = <"Cambio Healthcare Systems">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the result from the execution of the hip fracture study guidelines.">
			use = <"Use only in relation to the hip fracure study. The information produced by the guidelines is the result of specific study criteria.">
			keywords = <"healthcare indicators", "mortality", "hip fracture", "prosthesis surgery", "surgery", "osteosynthesis", "joint replacement", "Socialstyrelsen", "wait time">
			misuse = <"Do not use in other studies or context except in the case that the criteria are identical with those defined in the hip fracture study.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems<Konstantinos.Kalliamvakos@cambio.se>">
		["MD5-CAM-1.0.1"] = <"356C2EF5C37CE0F4036FAF6A17233C58">
		["references"] = <"1. Socialstyrelsen. Öppna jämförelser 2013 – Hälso- och sjukvård – Jämförelser mellan landsting. Västerås: Edita Västra Aros AB; 2013.
2. Socialstyrelsen. Bilaga 1 Beskrivning av indikatorer- Öppna jämförelser 2013: Hälso och sjukvård. 2013.">
	>

definition
	OBSERVATION[at0000] matches {	-- Hip fracture study
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Joint replacement surgery in patients with hip fracture
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- Absent
													at0006]	-- Present
												}
											}
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {	-- Wait time for surgery
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0008, 	-- 0-4 hours
													at0009, 	-- 5-9 hours
													at0010, 	-- 10-14 hours
													at0011, 	-- 15-19 hours
													at0012, 	-- 20-24 hours
													at0013, 	-- 25-48 hours
													at0014]	-- > 48 hours
												}
											}
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {	-- Time in waiting
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::128]>
												list = <
													["1"] = <
														units = <"h">
													>
												>
											>
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {	-- Date/time of first surgery
										value matches {
											DV_DATE_TIME matches {*}
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {	-- Hip fracture mortality
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0018, 	-- Died within 28 days
													at0019, 	-- Died within 29-90 days
													at0020, 	-- Died after 90 days
													at0021]	-- Alive
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

