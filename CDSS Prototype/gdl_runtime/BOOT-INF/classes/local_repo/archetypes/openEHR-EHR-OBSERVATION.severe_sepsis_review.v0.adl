archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.severe_sepsis_review.v0

concept
	[at0000]	-- Severe sepsis review
language
	original_language = <[ISO_639-1::sv]>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["organisation"] = <"Cambio Healthcare Systems">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["date"] = <"2013-12-18">
	>
	details = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"To document a review of any possible severe sepsis condition of the subject of care">
			use = <"">
			keywords = <"sepsis", "systemic inflammatory response syndrome", "SIRS", "severe sepsis">
			misuse = <"">
			copyright = <"">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. Brink M, Cronqvist J, Furebring M, Gårdlund B, Lanbeck P, Ljungström L, et al. Vårdprogram Svår sepsis och septisk chock - tidig identifiering och initial handläggning. Svenska Infektionsläkarföreningen; 2013.">
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"F0ECA7D90BBF48F436481D54C3B4BDC7">
	>

definition
	OBSERVATION[at0000] matches {	-- Severe sepsis review
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- vilken händelse som helst
						data matches {
							ITEM_TREE[at0003] matches {	-- Träd
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Severe Sepsis
										value matches {
											0|[local::at0006], 	-- Unlikely severe sepsis
											1|[local::at0007]  	-- Likely severe sepsis
										}
									}
									ELEMENT[at0013] occurrences matches {0..1} matches {	-- Severe Sepsis time
										value matches {
											DV_DATE_TIME matches {*}
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {	-- S-lactate
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::119]>
												list = <
													["1"] = <
														units = <"mmol/l">
													>
												>
											>
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {	-- S-lactate > 3
										value matches {
											0|[local::at0018], 	-- Absent
											1|[local::at0019]  	-- Present
										}
									}
									ELEMENT[at0014] occurrences matches {0..1} matches {	-- S-lactate time
										value matches {
											DV_DATE_TIME matches {*}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {	-- Systolic BP
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::125]>
												list = <
													["1"] = <
														units = <"mm[Hg]">
													>
												>
											>
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {	-- Systolic BP < 90
										value matches {
											0|[local::at0020], 	-- Absent
											1|[local::at0021]  	-- Present
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {	-- Systolic BP time
										value matches {
											DV_DATE_TIME matches {*}
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {	-- Responsible Unit
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

