definition
	OBSERVATION[at0000] matches {	-- Cancer process overview
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..*} matches {	-- Cancer process phase
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- 1-Suspected
													at0006, 	-- 2-Referral from suspicion
													at0007, 	-- 3-Well grounded suspicion
													at0008, 	-- 4-Referral from well grounded suspicion
													at0009, 	-- 5-First visit to specialized care
													at0010, 	-- 6-MDC
													at0011, 	-- 7-Decision on treatment
													at0012, 	-- 8-Treatment start
													at0013]	-- 9-Follow up
												}
											}
										}
									}
									ELEMENT[at0014] occurrences matches {0..*} matches {	-- Treatment intent
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0015, 	-- Curative-Chemotherapy
													at0016, 	-- Curative-Surgery
													at0017, 	-- Curative-Radiotherapy
													at0018, 	-- Palliative-Chemotherapy
													at0019, 	-- Palliative-Surgery
													at0020]	-- Palliative-Radiotherapy
												}
											}
										}
									}
									ELEMENT[at0021] occurrences matches {0..*} matches {	-- Treatment intent-Curative
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0022, 	-- Chemotherapy
													at0023, 	-- Surgery
													at0024]	-- Radiotherapy
												}
											}
										}
									}
									ELEMENT[at0025] occurrences matches {0..*} matches {	-- Treatment intent-Palliative
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0022, 	-- Chemotherapy
													at0023, 	-- Surgery
													at0024]	-- Radiotherapy
												}
											}
										}
									}
									ELEMENT[at0027] occurrences matches {0..1} matches {	-- Treatment intent category
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0028, 	-- Curative
													at0029]	-- Palliative
												}
											}
										}
									}
									ELEMENT[at0030] occurrences matches {0..1} matches {	-- Treatment type
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0022, 	-- Chemotherapy
													at0023, 	-- Surgery
													at0024]	-- Radiotherapy
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

