archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.vacterl_lungs.v0

concept
	[at0000]	-- Vacterl lungs
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["organisation"] = <"Cambio Healthcare Systems">
		["name"] = <"Joana Vicente">
		["email"] = <"joana.vicente@cambio.se">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record patient information for birth defects VACTERL lungs. Clinical relevant data is registred throught this archetype.">
			use = <"Use for patients with lung problems and birth defects VACTERL.">
			keywords = <"VACTERL", "lung", "lung function", "chronic cough", "inalation medication", "value based healthcare", "VBH">
			misuse = <"Do not use for other than to register patient data related to VACTERL syndrome and related lung problems.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera patient data för lungor relaterad till VACTERL syndrom. Klinisk data registreras i denna archetype.">
			use = <"Används för patienter med VACTERL syndrom och lungproblem.">
			keywords = <"VACTERL", "lungor", "lungfunktion", "vingscapula", "inhalationsläkemedel", "scolios", "kronisk hosta", "värdebaserad sjukvård", "VBH">
			misuse = <"Används inte för annat än för att registrera information för med VACTERL syndrom och lungproblem.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. LUL, Systemförvaltning (2009). \"Grundmall KB Esofagusatresi, analatresi, VACTERL\". Landstninget Uppsala Län.">
		["MD5-CAM-1.0.1"] = <"78831D5742286F267DF52CCCB4B71493">
	>

definition
	EVALUATION[at0000] matches {	-- Vacterl lungs
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Review date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					CLUSTER[at0003] occurrences matches {0..1} matches {	-- Lung/breathing
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0004] occurrences matches {0..1} matches {	-- Chronic cough
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0005, 	-- Normal
											at0006]	-- Reduced obstructive
										}
									}
								}
							}
							ELEMENT[at0007] occurrences matches {0..1} matches {	-- Scoliosis
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0005, 	-- Normal
											at0006]	-- Reduced obstructive
										}
									}
								}
							}
							ELEMENT[at0008] occurrences matches {0..1} matches {	-- Winged scapula
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0005, 	-- Normal
											at0006]	-- Reduced obstructive
										}
									}
								}
							}
							ELEMENT[at0009] occurrences matches {0..1} matches {	-- Pulmunary function
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0005, 	-- Normal
											at0006, 	-- Reduced obstructive
											at0010]	-- Reduced restrictive
										}
									}
								}
							}
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {	-- Pneumonia
						value matches {
							DV_COUNT matches {
								magnitude matches {|0..100|}
							}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {	-- Inhalated medication
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0013, 	-- Steroids
									at0014, 	-- Bronchodilatory
									at0015]	-- No
								}
							}
						}
					}
				}
			}
		}
	}

