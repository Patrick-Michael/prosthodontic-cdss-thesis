archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.mfi_20.v0

concept
	[at0000]	-- Multidimensional fatigue inventory
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2016-06-21">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record information regarding fatigue according to the MFI-20 self-evaluation.">
			use = <"Use to register the answers for each question as well as the total score for each of the 5 fatigue dimensions of MFI-20.">
			keywords = <"VBH", "value based healthcare", "MFI-20", "multidimensional fatigue inventory", "fatigue", "physical fatigue", "mental fatigue", "motivation", "activity">
			misuse = <"Do not use to register other fatigue related information that are not described in MFI-20.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera information kring patientens fatigue genom MFI-20 själv-utvärdering redskap.">
			use = <"Används för att registrera svaren till MFI-20 frågor och summa för varje 5 dimensioner.">
			keywords = <"VBH", "värdebaserad sjukvård", "MFI-20", "multidimensional fatigue inventory", "fatigue", "fysisk fatigue", "mental fatigue", "minskad motivation", "minskad aktivitet">
			misuse = <"Används inte för att registrera annat fatigue än den som beskrivs med MFI-20.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <"Joana Vicente", ...>
	other_details = <
		["references"] = <"1. Smets EMA, Garssen B, Bonke B, De Haes JCJM. The multidimensional Fatigue Inventory (MFI) psychometric qualities of an instrument to assess fatigue. J Psychosom Res. 1995;39(3):315–25.
2. Smets EM, Garssen B, Cull A, de Haes JC. Application of the multidimensional fatigue inventory (MFI-20) in cancer patients receiving radiotherapy. Vol. 73, British Journal of Cancer. 1996. p. 241–5.">
		["MD5-CAM-1.0.1"] = <"1BBA37CF74C3BAFDC96C6A823D47BCB4">
	>

definition
	EVALUATION[at0000] matches {	-- Multidimensional fatigue inventory
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Review date (time)
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					CLUSTER[at0003] occurrences matches {0..1} matches {	-- General fatigue
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0004] occurrences matches {0..1} matches {	-- 1. I feel fit.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0005] occurrences matches {0..1} matches {	-- 5. I feel tired.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0006] occurrences matches {0..1} matches {	-- 12. I am rested.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0007] occurrences matches {0..1} matches {	-- 16. I tire easily.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0008] occurrences matches {0..1} matches {	-- General fatigue - Total
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..20|}
									}
								}
							}
						}
					}
					CLUSTER[at0009] occurrences matches {0..1} matches {	-- Physical fatigue
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0010] occurrences matches {0..1} matches {	-- 2. Physically, I feel only able to do a little.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0011] occurrences matches {0..1} matches {	-- 8. Physically I can take on a lot.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0012] occurrences matches {0..1} matches {	-- 14. Physically I feel I am in a bad condition.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0013] occurrences matches {0..1} matches {	-- 20. Physically I feel I am in an excellent condition.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0014] occurrences matches {0..1} matches {	-- Physical fatigue - Total
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..20|}
									}
								}
							}
						}
					}
					CLUSTER[at0015] occurrences matches {0..1} matches {	-- Mental fatigue
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0016] occurrences matches {0..1} matches {	-- 7. When I am doing something, I can keep my thoughts on it.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0017] occurrences matches {0..1} matches {	-- 11. I can concentrate well.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0018] occurrences matches {0..1} matches {	-- 13. It takes a lot of effort to concentrate on things.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0019] occurrences matches {0..1} matches {	-- 19. My thoughts easily wander.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0020] occurrences matches {0..1} matches {	-- Mental fatigue - Total
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..20|}
									}
								}
							}
						}
					}
					CLUSTER[at0021] occurrences matches {0..1} matches {	-- Reduced activity
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0022] occurrences matches {0..1} matches {	-- 3. I feel very active.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0023] occurrences matches {0..1} matches {	-- 6. I think I do a lot in a day.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0024] occurrences matches {0..1} matches {	-- 10. I think I do very little in a day.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0025] occurrences matches {0..1} matches {	-- 17. I get little done.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0026] occurrences matches {0..1} matches {	-- Reduced activity - Total
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..20|}
									}
								}
							}
						}
					}
					CLUSTER[at0027] occurrences matches {0..1} matches {	-- Reduced motivation
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0028] occurrences matches {0..1} matches {	-- 4. I feel like doing all sorts of nice things.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0029] occurrences matches {0..1} matches {	-- 9. I dread having to do things.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0030] occurrences matches {0..1} matches {	-- 15. I have lots of plans.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0031] occurrences matches {0..1} matches {	-- 18. I don't feel like doing anything.
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..5|}
									}
								}
							}
							ELEMENT[at0032] occurrences matches {0..1} matches {	-- Reduced motivation - Total
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..20|}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Multidimensional fatigue inventory">
					description = <"Multidimensional Fatigue Inventory (MFI) is a 20-item self-report instrument designed to measure fatigue. It covers the following dimensions: General Fatigue, Physical Fatigue, Mental Fatigue, Reduced Motivation and Reduced Activity. [1]">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Review date (time)">
					description = <"*">
				>
				["at0003"] = <
					text = <"General fatigue">
					description = <"*">
				>
				["at0004"] = <
					text = <"1. I feel fit.">
					description = <"*">
				>
				["at0005"] = <
					text = <"5. I feel tired.">
					description = <"*">
				>
