		["sv"] = <
			items = <
				["at0000"] = <
					text = <"Multidimensional fatigue inventory">
					description = <"Multidimensional Fatigue Inventory (MFI) är ett 20 st egen rapporterad redskap som används för att mäta patientens fatigue. Den innehåller fem olika dimentioner: Generellt fatigue, Fysisk fatigue, Mental fatigue, Minskad aktivitet och Minskad motivation. [1]">
				>
				["at0001"] = <
					text = <"*Tree(en)">
					description = <"*@ internal @(en)">
				>
				["at0002"] = <
					text = <"Datum (tid) för översyn">
					description = <"**(en)">
				>
				["at0003"] = <
					text = <"Generell fatigue">
					description = <"**(en)">
				>
				["at0004"] = <
					text = <"1. Jag känner mig i form.">
					description = <"**(en)">
				>
				["at0005"] = <
					text = <"5. Jag känner mig trött.">
					description = <"**(en)">
				>
				["at0006"] = <
					text = <"12. Jag är utvilad.">
					description = <"**(en)">
				>
				["at0007"] = <
					text = <"16. Jag blir lätt trött.">
					description = <"**(en)">
				>
				["at0008"] = <
					text = <"Generell fatigue - Total">
					description = <"**(en)">
				>
				["at0009"] = <
					text = <"Fysisk fatigue">
					description = <"**(en)">
				>
				["at0010"] = <
					text = <"2. Kroppsligt känner jag mig bara i stånd att göra väldigt lite.">
					description = <"**(en)">
				>
				["at0011"] = <
					text = <"8. Kroppsligt orkar jag mycket.">
					description = <"**(en)">
				>
				["at0012"] = <
					text = <"14. Kroppsligt känner jag mig i dålig form.">
					description = <"**(en)">
				>
				["at0013"] = <
					text = <"20. Kroppsligt känner jag mig i utmärkt form.">
					description = <"**(en)">
				>
				["at0014"] = <
					text = <"Fysisk fatigue - Total">
					description = <"**(en)">
				>
				["at0015"] = <
					text = <"Mental fatigue">
					description = <"**(en)">
				>
				["at0016"] = <
					text = <"7. När jag gör något kan jag koncentrera mig på det.">
					description = <"**(en)">
				>
				["at0017"] = <
					text = <"11. Jag har lätt för att koncentrera mig.">
					description = <"**(en)">
				>
				["at0018"] = <
					text = <"13. Jag använder mycket kraft för att koncentrera mig på saker.">
					description = <"**(en)">
				>
				["at0019"] = <
					text = <"19. Mina tankar far lätt iväg.">
					description = <"**(en)">
				>
				["at0020"] = <
					text = <"Mental fatigue - Total">
					description = <"**(en)">
				>
				["at0021"] = <
					text = <"Minskad aktivitet">
					description = <"**(en)">
				>
				["at0022"] = <
					text = <"3. Jag känner mig mycket aktiv.">
					description = <"**(en)">
				>
				["at0023"] = <
					text = <"6. Jag tycker att jag hinner med mycket på en dag.">
					description = <"**(en)">
				>
				["at0024"] = <
					text = <"10. Jag får väldigt lite gjort under en dag.">
					description = <"**(en)">
				>
				["at0025"] = <
					text = <"17. Jag får inte mycket gjort.">
					description = <"**(en)">
				>
				["at0026"] = <
					text = <"Minskad aktivitet - Total">
					description = <"**(en)">
				>
				["at0027"] = <
					text = <"Minskad motivation">
					description = <"**(en)">
				>
				["at0028"] = <
					text = <"4. Jag har lust att göra en massa trevliga saker.">
					description = <"**(en)">
				>
				["at0029"] = <
					text = <"9. Jag fasar för att behöva göra något.">
					description = <"**(en)">
				>
				["at0030"] = <
					text = <"15. Jag massor av planer.">
					description = <"**(en)">
				>
				["at0031"] = <
					text = <"18. Jag har ingen lust att göra något.">
					description = <"**(en)">
				>
				["at0032"] = <
					text = <"Minskad motivation - Total">
					description = <"**(en)">
				>
			>
		>
	>
