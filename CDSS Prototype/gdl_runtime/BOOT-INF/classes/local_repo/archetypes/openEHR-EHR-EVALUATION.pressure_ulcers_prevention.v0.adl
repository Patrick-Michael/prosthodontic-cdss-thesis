archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.pressure_ulcers_prevention.v0

concept
	[at0000]	-- Pressure ulcers prevention measures
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To plan and document current and preventive measures for patients with active risk for pressure ulcers. To be used after the patients risk accessment for pressure ulcers and when this accessment reveals that the risk is present. ">
			use = <"Use to plan and describe current and planned clinical measures to avoid pressure ulcers in patients with active risk to develop pressure ulcers. ">
			keywords = <"Pressure ulcers", "prevention ", "measures", "Elderly", "Risk">
			misuse = <"Do not use for other than to plan and document current and future measures to prevent pressure ulcers in patients with an active risk. ">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att plannera och dokumentera pågående förebyggande åtgärder för risk för trycksår. ">
			use = <"Används för att plannera och beskriva pågående eller plannerade förebyggande åtgärder för patienter med aktivt trycksår risk. ">
			keywords = <"Prevention ", "Förebyggande", "Åtgärder", "Trycksår">
			misuse = <"Används inte för annat än för att plannera åtgärder som kan förebygga trycksår i patienter med aktivt risk för trycksår. ">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["references"] = <"Idwall E. Kvalitetsindikatorer inom omvårdnad. Gothia. 2013 
Lindholm C. Modifierad Nortonskala. 2013:  hämtad from www.vårdhandboken.se November 2015. ">
		["MD5-CAM-1.0.1"] = <"A1A41C0ACC6B00584DF900D48BEB55F5">
	>

definition
	EVALUATION[at0000] matches {	-- Pressure ulcers prevention measures
		data matches {
			ITEM_TREE[at0001] matches {	-- *Tree(en)
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- *New element(en)
						value matches {
							DV_DATE_TIME matches {
								value matches {yyyy-mm-ddTHH:??:??}
							}
						}
					}
					CLUSTER[at0003] occurrences matches {0..*} matches {	-- Enviromental adjustments
						items cardinality matches {1..4; ordered} matches {
							ELEMENT[at0040] occurrences matches {0..1} matches {	-- Body position in bed/chair
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
							ELEMENT[at0041] occurrences matches {0..1} matches {	-- Use of pressure ulcer prevention madress
								value matches {
