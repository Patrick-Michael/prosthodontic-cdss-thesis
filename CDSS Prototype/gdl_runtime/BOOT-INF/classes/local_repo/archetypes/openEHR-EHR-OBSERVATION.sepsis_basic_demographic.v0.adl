archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.sepsis_basic_demographic.v0

concept
	[at0000]	-- Sepsis basic demographic
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"CDS archetype to record demographic data for sepsis">
			use = <"">
			misuse = <"">
			copyright = <"">
		>
	>
