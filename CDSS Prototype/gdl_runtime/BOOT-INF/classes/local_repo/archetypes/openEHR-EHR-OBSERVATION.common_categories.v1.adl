archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.common_categories.v1

concept
	[at0000]	-- Common categories
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2015-03-17">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To provide a set of common filters or indicators for use in studies.">
			use = <"">
			keywords = <"common categories", "age", "gender", "diagnosis", "death", "age group">
			misuse = <"">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"Att tillhandahålla en uppsättning gemensamma filter eller indikatorer för användning i studier.">
			use = <"">
			keywords = <"gemensamma kategorier", "ålder", "kön", "diagnos", "död", "åldersgrupp">
			misuse = <"">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"1B316285C4C922AFCF512CF7DA6440BC">
	>

definition
	OBSERVATION[at0000] matches {	-- Common categories
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Age group
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- < 10 years old
													at0006, 	-- 10 - 19 years old
													at0007, 	-- 20 - 29 years old
													at0008, 	-- 30 - 39 years old
													at0009, 	-- 40 - 49 years old
													at0010, 	-- 50 - 59 years old
													at0011, 	-- 60 - 69 years old
													at0012, 	-- 70 - 79 years old
													at0013, 	-- 80 - 89 years old
													at0014, 	-- 90 - 99 years old
													at0015]	-- >= 100 years old
												}
											}
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {	-- Death
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0019, 	-- Absent
													at0020]	-- Present
												}
											}
										}
									}
									CLUSTER[at0017] occurrences matches {0..1} matches {	-- Diabetes diagnosis
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0018] occurrences matches {0..1} matches {	-- Diabetes
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0019, 	-- Absent
															at0020]	-- Present
														}
													}
												}
											}
											ELEMENT[at0021] occurrences matches {0..1} matches {	-- Type of Diabetes
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0022, 	-- Type 1 Diabetes
															at0023]	-- Type 2 Diabetes
														}
													}
												}
											}
										}
									}
									ELEMENT[at0024] occurrences matches {0..1} matches {	-- Last visited responsible medical unit
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

