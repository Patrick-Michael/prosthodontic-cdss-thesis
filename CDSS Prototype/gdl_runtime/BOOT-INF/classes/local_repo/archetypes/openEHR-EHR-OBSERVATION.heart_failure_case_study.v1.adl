archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.heart_failure_case_study.v1

concept
	[at0000]	-- Heart failure study
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2014-07-25">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the result from the execution of the heart failure study guidelines.">
			use = <"Use only in relation to the heart failure study. The information produced by the guidelines is the result of specific study criteria.">
			keywords = <"healthcare indicators", "length of stay", "hospitalization", "heart failure", "mortality", "survival", "RAAS inhibitors", "beta blockers", "Socialstyrelsen">
			misuse = <"Do not use in other studies or context except in the case that the criteria are identical with those defined in the heart failure study.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera resultatet vid körning av hjärtsviktstudiens riktlinjer.">
			use = <"Används endast i förhållande till hjärtsviktstudien. Den information som produceras av riktlinjerna är resultatet av särskilda studiekriterier.">
			keywords = <"öppna jämförelser", "vårtid", "sjukhusvård", "hjärtsvikt", "dödlighet", "överlevnad", "RAAS-hämmare", "betablockerare", "Socialstyrelsen">
			misuse = <"Använd inte i andra studier eller sammanhang utom när kriterierna är identiska med dem som definieras i hjärtsviktstudien.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. Socialstyrelsen. Öppna jämförelser 2013 – Hälso- och sjukvård – Jämförelser mellan landsting. Västerås: Edita Västra Aros AB; 2013.
2. Socialstyrelsen. Bilaga 1 Beskrivning av indikatorer- Öppna jämförelser 2013: Hälso och sjukvård. 2013.">
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"3BC2225D70771DA9FB1579609A524CCA">
	>

definition
	OBSERVATION[at0000] matches {	-- Heart failure study
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0004] occurrences matches {0..1} matches {	-- Medication in HF
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0005] occurrences matches {0..1} matches {	-- RAAS inhibitors and Beta-Blockers in Heart Failure patients
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0006, 	-- Absent
															at0007]	-- Present
														}
													}
												}
											}
											ELEMENT[at0008] occurrences matches {0..1} matches {	-- RAAS inhibitors after 6 months
												value matches {
													DV_BOOLEAN matches {
														value matches {True, False}
													}
												}
											}
											ELEMENT[at0009] occurrences matches {0..1} matches {	-- Beta-blockers after 6 months
												value matches {
													DV_BOOLEAN matches {
														value matches {True, False}
													}
												}
											}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {	-- Heart failure mortality
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0011, 	-- Died within 28 days
													at0012, 	-- Died within 29-90 days
													at0013, 	-- Died after 90 days
													at0014]	-- Alive
												}
											}
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {	-- Heart failure patients that got hospitalized within the last 12 months
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0006, 	-- Absent
													at0007]	-- Present
												}
											}
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {	-- Number of hospitalized days for patients with heart failure
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0017, 	-- < 3 days
													at0018, 	-- 3-5 days
													at0019, 	-- 6-10 days
													at0020, 	-- 11-20 days
													at0021, 	-- 21-30 days
													at0022]	-- > 30 days
												}
											}
										}
									}
									ELEMENT[at0023] occurrences matches {0..1} matches {	-- Length of stay
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::128]>
												list = <
													["1"] = <
														units = <"d">
													>
													["2"] = <
														units = <"millisec">
													>
												>
											>
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

