archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.mini_nutritional_assessment.v0

concept
	[at0000]	-- Mini Nutritional Assessment (MNA)
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Medical Informatics Group (MIG)">
		["email"] = <"mig@cambiocds.com">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2017-04-10">
	>
	details = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att ge en enkel och snabb bedömning av nutritionsstatus för patienter i öppenvården, kliniker, sjukhus och äldreboenden.">
			use = <"">
			keywords = <"Mini Nutritional Assessment", "MNA", "äldre", "näring", "undernäring">
			misuse = <"">
			copyright = <"Cambio Healthcare Systems">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To provide a single, rapid assessment of nutritional status for patients in outpatient clinics, hospitals, and nursing homes.">
			use = <"">
			keywords = <"Mini Nutritional Assessment", "MNA", "elderly", "nutrition", "malnutrition">
			misuse = <"">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <"Oskar Nielsen", ...>
	other_details = <
		["references"] = <"1. Vellas B, Villars H, Abellan G, et al. Overview of the MNA® - Its History and Challenges. J Nutr Health Aging 2006;10:456-465.
2. Rubenstein LZ, Harker JO, Salva A, Guigoz Y, Vellas B. Screening for Undernutrition in Geriatric Practice: Developing the Short-Form Mini Nutritional Assessment (MNA-SF).
3. J. Geront 2001;56A: M366-377. Guigoz Y. The Mini-Nutritional Assessment (MNA®) Review of the Literature - What does it tell us? J Nutr Health Aging 2006; 10:466-487.
4. Kaiser MJ, Bauer JM, Ramsch C, et al.  Validation of the Mini Nutritional Assessment Short-Form (MNA®-SF): A practical tool for identification  of nutritional status.  J Nutr Health Aging 2009; 13:782-788.">
		["MD5-CAM-1.0.1"] = <"0806A46B4C48450F609A7EA015DE72A7">
	>

definition
	EVALUATION[at0000] matches {	-- Mini Nutritional Assessment (MNA)
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Has food intake declined over the past 3 months?
						value matches {
							0|[local::at0003], 	-- Severe decrease in food intake
							1|[local::at0004], 	-- Moderate decrease in food intake
							2|[local::at0005]  	-- No decrease in food intake
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {	-- Weight loss during the last 3 months
						value matches {
							0|[local::at0007], 	-- Weight loss greater than 3kg
							1|[local::at0008], 	-- Does not know
							2|[local::at0009], 	-- Weight loss between 1 and 3kg
							3|[local::at0010]  	-- No weight loss
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {	-- Mobility
						value matches {
							0|[local::at0012], 	-- Bed or chair bound
							1|[local::at0013], 	-- Able to get out of bed/chair but does not go out
							2|[local::at0014]  	-- Goes out
						}
					}
					ELEMENT[at0016] occurrences matches {0..1} matches {	-- Psychological stress/acute disease last 3 months
						value matches {
							0|[local::at0017], 	-- Yes
							2|[local::at0018]  	-- No
						}
					}
					ELEMENT[at0019] occurrences matches {0..1} matches {	-- Neuropsychological problems
						value matches {
							0|[local::at0020], 	-- Severe dementia or depression
							1|[local::at0021], 	-- Mild dementia
							2|[local::at0022]  	-- No psychological problems
						}
					}
					ELEMENT[at0023] occurrences matches {0..1} matches {	-- Body Mass Index (kg/m2)
						value matches {
							0|[local::at0024], 	-- BMI less than 19
							1|[local::at0025], 	-- BMI 19 to less than 21
							2|[local::at0026], 	-- BMI 21 to less than 23
							3|[local::at0027]  	-- BMI 23 or greater 
						}
					}
					ELEMENT[at0028] occurrences matches {0..1} matches {	-- Total score
						value matches {
							DV_COUNT matches {*}
						}
					}
					ELEMENT[at0029] occurrences matches {0..1} matches {	-- Nutrition status
						value matches {
							0|[local::at0030], 	-- Normal nutritional status
							1|[local::at0031], 	-- At risk of malnutrition
							2|[local::at0032]  	-- Malnourished
						}
					}
					ELEMENT[at0033] occurrences matches {0..1} matches {	-- Review date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
				}
			}
		}
	}

