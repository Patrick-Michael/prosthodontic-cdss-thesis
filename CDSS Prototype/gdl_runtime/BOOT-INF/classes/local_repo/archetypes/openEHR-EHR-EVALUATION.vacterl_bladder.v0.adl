archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.vacterl_bladder.v0

concept
	[at0000]	-- Vacterl bladder
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["organisation"] = <"Cambio Healthcare Systems">
		["name"] = <"Joana Vicente">
		["email"] = <"joana.vicente@cambio.se">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record patient information for birth defects VACTERL bladder.Clinical relevant data is registered throught this archetype.">
			use = <"Use for patients with bladder problems and birth defects VACTERL.">
			keywords = <"VACTERL", "urin leackage", "urinary infection", "catheterization", "micturition", "VBH", "value based healthcare">
			misuse = <"Do not use for other than to register patient data related to VACTERL sindrome and related instestinal problems.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera patient data för urinblåsa relaterad till VACTERL syndrom. Klinisk data registreras i denna archetype.">
			use = <"Används för patienter med VACTERL syndrom och urinblåsa problem.">
			keywords = <"VACTERL", "urinläckage", "miktionskontroll", "inkontinenshjälpmedel", "urinvägsinfektion", "katetrisering", "VBH", "värdebaserad sjukvård">
			misuse = <"Används inte för annat än för att registrera information för med VACTERL syndrom och urinblåsa problem.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. LUL, Systemförvaltning (2009). \"Grundmall KB Esofagusatresi, analatresi, VACTERL\". Landstninget Uppsala Län.">
		["MD5-CAM-1.0.1"] = <"5BADD327500AD7DDDB69054B1782A4E8">
	>

definition
	EVALUATION[at0000] matches {	-- Vacterl bladder
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Review date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					CLUSTER[at0003] occurrences matches {0..1} matches {	-- Micturition
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0004] occurrences matches {0..1} matches {	-- Micturition control 
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0005, 	-- Yes
											at0006, 	-- No
											at0007]	-- Not relevant due to age
										}
									}
								}
							}
							ELEMENT[at0008] occurrences matches {0..1} matches {	-- Incontinence aid 
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0005, 	-- Yes
											at0006]	-- No
										}
									}
								}
							}
						}
					}
					CLUSTER[at0009] occurrences matches {0..1} matches {	-- Urine
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0010] occurrences matches {0..1} matches {	-- Urine leackage
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0011, 	-- Everyday
											at0012, 	-- About once a week
											at0013, 	-- Once a month
											at0014]	-- No
										}
									}
								}
							}
							ELEMENT[at0015] occurrences matches {0..1} matches {	-- Urinary infection
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..100|}
									}
								}
							}
							ELEMENT[at0016] occurrences matches {0..1} matches {	-- Intermittent catheterization
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0005, 	-- Yes
											at0014]	-- No
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

