archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.svf_prostatacancer_categories.v0

concept
	[at0000]	-- Svf prostatacancer categories
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Joana Vicente">
		["email"] = <"joana.vicente@cambio.se">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Set Dashboard categories for SVF prostata cancer case study.">
			use = <"Use to register patient data into Dashboard categories for the SVF prostata cancer case study.
">
			keywords = <"SVF", "prostate ", "cancer ">
			misuse = <"Do not use to register data for a process other than  the SVF prostata cancer case study.
">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["references"] = <"Socialstyrelsen (2015). Standardiserade vårdförlopp i cancervården. En baslinjestudie. Hämtad från https://www.socialstyrelsen.se/Lists/Artikelkatalog/Attachments/19926/2015-10-5.pdf Februari 2016. 
Regionala Cancercentrum i Samverkan (2016).Prostatacancer Primärvårdsversion av standardiseradt vårdförlopp 2016. Hämtad från http://www.cancercentrum.se/globalassets/vara-uppdrag/kunskapsstyrning/varje-dag-raknas/vardforlopp/primarvardsversioner_standardiserade_vardforlopp_20151221.pdf Februari 2016. ">
		["MD5-CAM-1.0.1"] = <"284EDD451EEABA176BB62505C6BFD1EB">
	>

definition
	OBSERVATION[at0000] matches {	-- Svf prostatacancer categories
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Antal dagar från VGM remissbeslut till remissankomst
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- 0-3- Inom SVF mål
													at0006, 	-- 4-6
													at0007, 	-- 7-9
													at0008, 	-- 10-13
													at0009]	-- Mer än 14
												}
											}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {	-- Antal dagar från remissankomnst VGM till första besök (Block A)
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0113, 	-- 0-14- Inom SVF mål
													at0114, 	-- 15-28
													at0115, 	-- 29-42
													at0116, 	-- 43-56
													at0117]	-- Mer än 57
												}
											}
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {	-- Antal dagar från första besök till biopsi
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0023, 	-- 0-10
													at0024, 	-- 11-20
													at0025, 	-- 21-30
													at0026, 	-- 31-40
													at0027]	-- Mer än 40
												}
											}
										}
									}
									ELEMENT[at0041] occurrences matches {0..1} matches {	-- Antal dagar från VGM remissbeslut till Biopsi
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0042, 	-- 0-20
													at0043, 	-- 21-40
													at0044, 	-- 41-60
													at0045, 	-- 61-80
													at0046]	-- Mer än 81
												}
											}
										}
									}
									ELEMENT[at0035] occurrences matches {0..1} matches {	-- Antal dagar från biopsi till möte med patient
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0036, 	-- 0-11- Inom SVF mål
													at0037, 	-- 12-22
													at0038, 	-- 23-33
													at0039, 	-- 34-44
													at0040]	-- Mer än 44
												}
											}
										}
									}
									ELEMENT[at0028] occurrences matches {0..1} matches {	-- Antal dagar från VGM remissbeslut till möte med patient
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0029, 	-- 0-28- Inom SVF mål för låg- och mellanriskcancer
													at0030, 	-- 29-56
													at0031, 	-- 57-84
													at0032, 	-- 85-112
													at0033]	-- Mer än 113
												}
											}
										}
									}
									ELEMENT[at0047] occurrences matches {0..1} matches {	-- Antal dagar från remissbeslut vid VGM till remiss till bilddiagnostik
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0048, 	-- 0-28
													at0049, 	-- 29-56
													at0050, 	-- 57-84
													at0051, 	-- 85-112
													at0052]	-- Mer än 113
												}
											}
										}
									}
									ELEMENT[at0053] occurrences matches {0..1} matches {	-- Antal dagar från remiss till bilddiagnostik till svar till remitenten
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0054, 	-- 0-14- Inom SVF mål
													at0055, 	-- 15-28
													at0056, 	-- 29-42
													at0057, 	-- 43-56
													at0058]	-- Mer än 57
												}
											}
										}
									}
									ELEMENT[at0059] occurrences matches {0..1} matches {	-- Antal dagar från svar till remitenten till MDK multidisciplinära konferens
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0061, 	-- 0-20
													at0062, 	-- 21-40
													at0063, 	-- 41-60
													at0064, 	-- 61-80
													at0065]	-- Mer än 81
												}
											}
										}
									}
									ELEMENT[at0066] occurrences matches {0..1} matches {	-- Antal dagar från VGM remissbeslut till MDK
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0067, 	-- 0-28
													at0068, 	-- 29-56
													at0069, 	-- 57-84
													at0070, 	-- 85-112
													at0071]	-- Mer än 113
												}
											}
										}
									}
									ELEMENT[at0072] occurrences matches {0..1} matches {	-- Antal dagar från MDK till behandlingsbeslut
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0073, 	-- 0-3
													at0074, 	-- 4-6
													at0075, 	-- 7-9
													at0076, 	-- 10-13
													at0077]	-- Mer än 14
												}
											}
										}
									}
									ELEMENT[at0078] occurrences matches {0..1} matches {	-- Antal dagar från remissbeslut vid VGM till behandlingsbeslut
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0079, 	-- 0-28
													at0080, 	-- 29-56
													at0081, 	-- 57-84
													at0082, 	-- 85-112
													at0083]	-- Mer än 113
												}
											}
										}
									}
									ELEMENT[at0084] occurrences matches {0..1} matches {	-- Antal dagar från behandlingsbeslut till behandlingsstart
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0090, 	-- 0-28- Inom SVF mål 
													at0091, 	-- 29-56
													at0092, 	-- 57-84
													at0093, 	-- 85-112
													at0094]	-- Mer än 113
												}
											}
										}
									}
									ELEMENT[at0095] occurrences matches {0..1} matches {	-- Antal dagar från remissbeslut vid VGM till behandlingsstart
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0096, 	-- 0-28- Inom SVF mål för för högriskcancer där kurativt syftande behandling inte är aktuell
													at0097, 	-- 29-60-Inom SVF mål för Högriskcancer där kurativt syftande behandling kan vara aktuell
													at0098, 	-- 61-84
													at0099, 	-- 85-112
													at0100]	-- Mer än 113
												}
											}
										}
									}
									ELEMENT[at0101] occurrences matches {0..1} matches {	-- Antal dagar från behandlingsstart till follow up
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0102, 	-- 0-20
													at0103, 	-- 21-40
													at0104, 	-- 41-60
													at0105, 	-- 61-80
													at0106]	-- Mer än 81
												}
											}
										}
									}
									ELEMENT[at0107] occurrences matches {0..1} matches {	-- Antal dagar från remissbeslut vid VGM till follow-up
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0108, 	-- 0-50
													at0109, 	-- 51-100
													at0110, 	-- 101-150
													at0111, 	-- 151-200
													at0112]	-- Mer än 200
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

