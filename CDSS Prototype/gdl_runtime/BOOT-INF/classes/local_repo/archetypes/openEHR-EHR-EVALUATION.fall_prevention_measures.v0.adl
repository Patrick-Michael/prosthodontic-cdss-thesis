archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.fall_prevention_measures.v0

concept
	[at0000]	-- Fall prevention åtgärder
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To be used in combination with a patients accessment for risk for fall. It provides a way of registering the current and planned preventive measures to avoid fall. ">
			use = <"Used to plan and decide on the preventives measures that need to be implemented for a patient with and active risk for fall. ">
			keywords = <"Fall prevention ", "Risk for fall", "Elderly", "Fall", "Risk">
			misuse = <"Do not use for other than to organise, plan and decide on the preventive measures to avoid fall in patients with active risk for fall. ">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"Ska användas i kombination med DFRI (Downton Fall Risk Index) riskbedömning för rirsk för fall. Planerade och pågående förebyggande åtgärder för att förebygga risk för fall listas i detta archetype. Används ofta inom äldreomsorg. ">
			use = <"Används för planerade och pågående förebyggande åtgärder för att förebygga risk för fall i patienter med aktiv risk för fall efter riskbedömning med Downton Fall Risk Index.">
			keywords = <"Fallprevention ", "Risk", "Förebyggande", "Äldre", "Risk för fall ", "Prevention ">
			misuse = <"Används inte för annat än för att organisera planerade och pågående förebyggande åtgärder för fall. Används endast för patienter med aktiv risk för fall enligt DFRI riskbedömningsinstrument. ">
			copyright = <"Cambio Healthcare Systems(en)">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["references"] = <"Idwall E. Kvalitetsindikatorer inom omvårdnad. Gothia. 2013 
Skog M. Riskbedömning. 2013:  hämtad from www.vårdhandboken.se November 2015.">
		["MD5-CAM-1.0.1"] = <"1FEE62497164C83501D98FF19FECF1BD">
	>

definition
	EVALUATION[at0000] matches {	-- Fall prevention åtgärder
		data matches {
			ITEM_TREE[at0001] matches {	-- *Tree(en)
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- *New element(en)
						value matches {
							DV_DATE_TIME matches {
								value matches {yyyy-mm-ddTHH:??:??}
							}
						}
					}
					CLUSTER[at0003] occurrences matches {0..1} matches {	-- Muskelfunktions- och styrketräning 
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0004] occurrences matches {0..1} matches {	-- Styrketräning
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
							ELEMENT[at0006] occurrences matches {0..1} matches {	-- Balansträning
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
							ELEMENT[at0008] occurrences matches {0..1} matches {	-- Gångträning
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
							ELEMENT[at0007] occurrences matches {0..1} matches {	-- Träning avfysisk prestationsförmåga
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
							ELEMENT[at0005] occurrences matches {0..1} matches {	-- Annan åtgärd- Muskelfunktions- och styrketräning
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
						}
					}
					CLUSTER[at0009] occurrences matches {0..1} matches {	-- Förflyttning och personlig vård
						items cardinality matches {1..*; unordered} matches {
