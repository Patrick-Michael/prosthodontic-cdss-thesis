									}
								}
							}
							ELEMENT[at0014] occurrences matches {0..1} matches {	-- Träning av å- och avklädning 
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
							ELEMENT[at0011] occurrences matches {0..1} matches {	-- Annan åtgärd- Förflyttning och personlig vård 
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
						}
					}
					CLUSTER[at0016] occurrences matches {0..1} matches {	-- Omgivsningsanpassning
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0017] occurrences matches {0..1} matches {	-- Anpassning av möblering och inventarier
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
							ELEMENT[at0018] occurrences matches {0..1} matches {	-- Hjälpmedelsförskrivning 
								value matches {
