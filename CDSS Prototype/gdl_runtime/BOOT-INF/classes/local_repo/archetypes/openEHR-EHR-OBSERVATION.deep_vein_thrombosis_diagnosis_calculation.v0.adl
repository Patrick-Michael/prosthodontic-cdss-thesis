archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.deep_vein_thrombosis_diagnosis_calculation.v0

concept
	[at0000]	-- *Deep vein thrombosis diagnosis calculation(en)
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To calculate the cllinical risk for deep vein thrombosis.">
			use = <"To calculate the cllinical risk for deep vein thrombosis.">
			keywords = <"DVT", "embolism", "deep vein thrombosis", "risk factors", "diagnosis", "thrombus">
			misuse = <"Attention should be taken to the fact that this diagnosis aid is not evaluated for patients with the Pill, estrogen treatment, pregnancy and 8 weeks postpartum. Do not use for other then to calculate and assess the risk for DVT.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"*To calculate the cllinical risk for deep vein thrombosis.(en)">
			use = <"*To calculate the cllinical risk for deep vein thrombosis.(en)">
			keywords = <"*DVT(en)", "*embolism(en)", "*deep vein thrombosis(en)", "*risk factors(en)", "*diagnosis(en)", "*thrombus(en)">
			misuse = <"*Attention should be taken to the fact that this diagnosis aid is not evaluated for patients with the Pill, estrogen treatment, pregnancy and 8 weeks postpartum. Do not use for other then to calculate and assess the risk for DVT.(en)">
			copyright = <"*Cambio Healthcare Systems(en)">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["references"] = <"Eriksson H., et al. Djup Ventrombos. From www.internetmedicin.se, November 2015. 
Socialstyrelsen. Socialstyrelsens riktlinjer för vård av blodpropp/venös tromboembolism 2004. Stockholm 2004. 
Wells PS, Hirsh J, Anderson DR, et al. Accuracy of clinical assessment of deep-vein thrombosis. Lancet 1995;345:1326-30">
		["MD5-CAM-1.0.1"] = <"5AC5B8D14A021DAD6E43BBE49D2342CB">
	>

definition
	OBSERVATION[at0000] matches {	-- *Deep vein thrombosis diagnosis calculation(en)
		data matches {
			HISTORY[at0001] matches {	-- *Event Series(en)
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- *Any event(en)
						data matches {
							ITEM_TREE[at0003] matches {	-- *Tree(en)
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Malignitet
										value matches {
											0|[local::at0005], 	-- Nej
											1|[local::at0007]  	-- Ja
										}
									}
									ELEMENT[at0006] occurrences matches {0..1} matches {	-- Paralys/pares/gipsbehandling av ben
										value matches {
											0|[local::at0008], 	-- Nej
											1|[local::at0010]  	-- Ja
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {	-- Immobilisering > 3 d eller större kirurgi inom 4 v med narkos/regional anestesi
										value matches {
											0|[local::at0011], 	-- Nej
											1|[local::at0013]  	-- Ja
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {	-- Ömhet/smärta längs djupa vener
										value matches {
											0|[local::at0014], 	-- Nej
											1|[local::at0016]  	-- Ja
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {	-- Helbenssvullnad	
										value matches {
											0|[local::at0017], 	-- Nej
											1|[local::at0019]  	-- Ja
										}
									}
									ELEMENT[at0018] occurrences matches {0..1} matches {	-- Vadsvullnad > 3 cm jämfört med andra benet
										value matches {
											0|[local::at0020], 	-- Nej
											1|[local::at0022]  	-- Ja
										}
									}
									ELEMENT[at0021] occurrences matches {0..1} matches {	-- Pittingödem i det symtomatiska benet
										value matches {
											0|[local::at0023], 	-- Nej
											1|[local::at0025]  	-- Ja
										}
									}
									ELEMENT[at0024] occurrences matches {0..1} matches {	-- Ytliga kollateraler (ej varicer)
										value matches {
											0|[local::at0026], 	-- *Absent(en)
											1|[local::at0028]  	-- *Present(en)
										}
									}
									ELEMENT[at0027] occurrences matches {0..1} matches {	-- Tidigare objektivt påvisad DVT
										value matches {
											0|[local::at0029], 	-- Nej
											1|[local::at0031]  	-- Ja
										}
									}
									ELEMENT[at0039] occurrences matches {0..1} matches {	-- Alternativ diagnos minst lika sannolik
										value matches {
											-2|[local::at0047], 	-- *Present(en)
											0|[local::at0046]  	-- *Absent(en)
										}
									}
									ELEMENT[at0033] occurrences matches {0..1} matches {	-- Total poäng
										value matches {
											DV_COUNT matches {*}
										}
									}
									ELEMENT[at0043] occurrences matches {0..1} matches {	-- Klinisk sannolikhet
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0044, 	-- *High Risk (en)
													at0045]	-- *Low Risk(en)
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

