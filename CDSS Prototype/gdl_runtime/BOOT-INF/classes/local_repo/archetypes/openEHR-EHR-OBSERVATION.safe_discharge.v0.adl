definition
	OBSERVATION[at0000] matches {	-- Safe discharge
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Age > 70 years old
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0012, 	-- Absent
													at0013]	-- Present
												}
											}
										}
									}
									ELEMENT[at0005] occurrences matches {0..1} matches {	-- Previous hospitalization during the last 12 months
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0012, 	-- Absent
													at0013]	-- Present
												}
											}
										}
									}
									ELEMENT[at0006] occurrences matches {0..1} matches {	-- Diabetes
										value matches {
