												defining_code matches {
													[local::
													at0012, 	-- Absent
													at0013]	-- Present
												}
											}
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {	-- Atrial fibrillation
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0012, 	-- Absent
													at0013]	-- Present
												}
											}
										}
									}
									ELEMENT[at0008] occurrences matches {0..1} matches {	-- Heart failure
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0012, 	-- Absent
													at0013]	-- Present
												}
											}
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {	-- COPD
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0012, 	-- Absent
													at0013]	-- Present
												}
											}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {	-- Stroke
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0012, 	-- Absent
													at0013]	-- Present
												}
											}
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {	-- 7 or more ongoing medications
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0012, 	-- Absent
													at0013]	-- Present
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

