definition
	EVALUATION[at0000] matches {	-- Cardiovascular risk factors review
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Male sex
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {	-- Age (men ≥55 years; women ≥65 years)
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {	-- Smoking
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {	-- Dyslipidaemia
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {	-- Abnormal fasting plasma glucose
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {	-- Abnormal glucose tolerance test
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {	-- Obesity
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {	-- Abdominal obesity
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {	-- Family history of premature CVD
						value matches {
							0|[local::at0003], 	-- Absent
							1|[local::at0004]  	-- Present
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {	-- Total risk factors
						value matches {
							DV_COUNT matches {
								magnitude matches {|>=0|}
							}
						}
					}
				}
			}
		}
	}

