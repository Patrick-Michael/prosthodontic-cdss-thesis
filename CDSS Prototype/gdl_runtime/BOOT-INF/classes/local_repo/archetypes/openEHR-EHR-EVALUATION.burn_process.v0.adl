					text = <"Har du klåda pga brännskadan?">
					description = <"**(en)">
				>
				["at0014"] = <
					text = <"Aldrig">
					description = <"*">
				>
				["at0015"] = <
					text = <"Ibland">
					description = <"*">
				>
				["at0016"] = <
					text = <"Ofta">
					description = <"*">
				>
				["at0017"] = <
					text = <"Hela tiden">
					description = <"*">
				>
				["at0018"] = <
					text = <"Om du har klåda, hur svår är din klåda från brännskadan?">
					description = <"**(en)">
				>
				["at0019"] = <
					text = <"Min handfunktion är begränsad som en följd av brännskadan">
					description = <"**(en)">
				>
