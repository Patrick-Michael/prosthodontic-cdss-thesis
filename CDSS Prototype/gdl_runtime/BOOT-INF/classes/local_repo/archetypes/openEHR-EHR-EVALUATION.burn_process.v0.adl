					text = <"Till viss del">
					description = <"*">
				>
				["at0022"] = <
					text = <"Nej">
					description = <"**(en)">
				>
				["at0023"] = <
					text = <"Utseendet på mina ärr stör mig">
					description = <"**(en)">
				>
