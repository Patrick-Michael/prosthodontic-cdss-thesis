archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.burn_process.v0

concept
	[at0000]	-- Burn process
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Blanca Flores">
		["email"] = <"blanca.flores@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2016-01-13">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To register patient data for the burn process case study for value-based healthcare.">
			use = <"Use to register patient data for the burn process study.">
			keywords = <"VBH", "value based healthcare", "burn process">
			misuse = <"Do not use to register data for a process other than the burn process.">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera patient data för Brännskador case studien inom Värdevbaserad sjukvård processen.">
			use = <"Används för att registrera data för Brännskador processen studie.">
			keywords = <"VBH", "brännskador process">
			misuse = <"Används inte för annat än för att registrera patient data för Brännskador processen studie.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. Grundmall Jorunaltabell. (2009). Mallnamn: Bräannskador. Systemförvaltning EPJ.">
		["MD5-CAM-1.0.1"] = <"6450D1BD116D0C86176CA1D9CD8AB6FB">
	>

definition
	EVALUATION[at0000] matches {	-- Burn process
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0002] occurrences matches {0..1} matches {	-- Lower extremities
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0003] occurrences matches {0..1} matches {	-- General movement and muscle function
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..6|}
									}
								}
							}
							ELEMENT[at0004] occurrences matches {0..1} matches {	-- Muscular strength
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..14|}
									}
								}
							}
							ELEMENT[at0005] occurrences matches {0..1} matches {	-- Balance and coordination
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..10|}
									}
								}
							}
							ELEMENT[at0006] occurrences matches {0..1} matches {	-- Endurance
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..10|}
									}
								}
							}
							ELEMENT[at0007] occurrences matches {0..1} matches {	-- Lower extremities total score
								value matches {
									DV_COUNT matches {
										magnitude matches {|0..40|}
									}
								}
							}
						}
					}
					CLUSTER[at0008] occurrences matches {0..1} matches {	-- Shoulder-arm
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0009] occurrences matches {0..1} matches {	-- Function right
								value matches {
									DV_COUNT matches {
										magnitude matches {|5..30|}
									}
								}
							}
							ELEMENT[at0010] occurrences matches {0..1} matches {	-- Function left
								value matches {
									DV_COUNT matches {
										magnitude matches {|5..30|}
									}
								}
							}
							ELEMENT[at0011] occurrences matches {0..1} matches {	-- Shoulder-arm total score
								value matches {
									DV_COUNT matches {
										magnitude matches {|10..60|}
									}
								}
							}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {	-- Pain when in motion
						value matches {
							DV_COUNT matches {
								magnitude matches {|0..10|}
							}
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {	-- Do you have itching due to burn
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0014, 	-- Never
									at0015, 	-- Sometimes
									at0016, 	-- Often
									at0017]	-- All the time
								}
							}
						}
					}
					ELEMENT[at0018] occurrences matches {0..1} matches {	-- If you have itching from the burn, how severe is it?
						value matches {
							DV_COUNT matches {
								magnitude matches {|0..10|}
							}
						}
					}
					ELEMENT[at0019] occurrences matches {0..1} matches {	-- My hand function is limited as a result of the burn
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0020, 	-- Yes
									at0021, 	-- Partially
									at0022]	-- No
								}
							}
						}
					}
					ELEMENT[at0023] occurrences matches {0..1} matches {	-- The look of my scars bothers me
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0020, 	-- Yes
									at0021, 	-- Partially
									at0022]	-- No
								}
							}
						}
					}
					ELEMENT[at0024] occurrences matches {0..1} matches {	-- My burns have open wounds
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0020, 	-- Yes
									at0021, 	-- Partially
									at0022]	-- No
								}
							}
						}
					}
					ELEMENT[at0025] occurrences matches {0..1} matches {	-- I have reduced appetite
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0020, 	-- Yes
									at0021, 	-- Partially
									at0022]	-- No
								}
							}
						}
					}
					ELEMENT[at0026] occurrences matches {0..1} matches {	-- My burns affect my work/employment
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0020, 	-- Yes
									at0021, 	-- Partially
									at0022]	-- No
								}
							}
						}
					}
					ELEMENT[at0027] occurrences matches {0..1} matches {	-- I use alcohol, tobacco or drugs to deal with the problems
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0020, 	-- Yes
									at0021, 	-- Partially
									at0022]	-- No
								}
							}
						}
					}
					ELEMENT[at0028] occurrences matches {0..1} matches {	-- Burn process review date (time)
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
				}
			}
		}
	}

