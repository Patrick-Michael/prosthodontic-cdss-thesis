definition
	EVALUATION[at0000] matches {	-- *Prostate cancer screening input(en)
		data matches {
			ITEM_TREE[at0001] matches {	-- *Tree(en)
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Ärftlig riskgrupp
						value matches {
							0|[local::at0005], 	-- Nej
							1|[local::at0006]  	-- Ja
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {	-- Har symptom
						value matches {
							0|[local::at0007], 	-- Nej
							1|[local::at0008]  	-- Ja
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {	-- Har positiva fyndet hos prostata palpation
						value matches {
							0|[local::at0009], 	-- Nej
							1|[local::at0010]  	-- Ja
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {	-- Förväntad kvarvarande livstid under 10 år
						value matches {
							0|[local::at0012], 	-- Nej
							1|[local::at0013]  	-- Ja
						}
					}
				}
			}
		}
	}

