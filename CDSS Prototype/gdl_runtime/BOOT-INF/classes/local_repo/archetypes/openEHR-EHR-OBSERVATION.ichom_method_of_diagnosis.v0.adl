archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.ichom_method_of_diagnosis.v0

concept
	[at0000]	-- ICHOM method of diagnosis
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Blanca Flores">
		["organisation"] = <"Cambio Healthcare Systems">
		["email"] = <"blanca.flores@cambio.se">
		["date"] = <"2015-11-27">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To register the method of diagnosis as baseline tumor factors for the ICHOM Lung cancer data collection.">
			use = <"To register the method of diagnosis for cancer.  ">
			keywords = <"lung cancer", "ICHOM", "diagnosis">
			misuse = <"Do not use to register data outside the ICHOM measures.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["references"] = <"ICHOM Lung Cancer Data Collection Reference Guide. International Consortium for Health Outcome Measurement. Version 2.1. Revised April 24th, 2015. ">
		["MD5-CAM-1.0.1"] = <"087BEB6C1648202D04F92A88A5BAF772">
	>

definition
	OBSERVATION[at0000] matches {	-- ICHOM method of diagnosis
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Method of diagnosis
										value matches {
											1|[local::at0005], 	-- Clinical assessment
											2|[local::at0006], 	-- Histological assessment
											3|[local::at0007], 	-- Cytological assessment
											999|[local::at0008]  	-- Unknown
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"ICHOM method of diagnosis">
					description = <"unknown">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"*">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Method of diagnosis">
					description = <"*">
				>
				["at0005"] = <
					text = <"Clinical assessment">
					description = <"*">
				>
				["at0006"] = <
					text = <"Histological assessment">
					description = <"*">
				>
				["at0007"] = <
					text = <"Cytological assessment">
					description = <"*">
				>
				["at0008"] = <
					text = <"Unknown">
					description = <"*">
				>
			>
		>
	>
