archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.esophagus_cancer.v0

concept
	[at0000]	-- Esophagus cancer
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Joana Vicente">
		["email"] = <"joana.vicente@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2016-06-17">
	>
	details = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera patient data för Esofagus- och Kardiacancer. Patientens egna rapporterad och klinisk data registreras i denna archetype.">
			use = <"Används för patienter med esofaguscancer eller kardiacancer.">
			keywords = <"VBH", "värdebaserad sjukvård", "esophaguscancer", "kardiacancer", "cancer">
			misuse = <"Används inte för annat än för att registrera information för esophagus och kardiacancer.">
			copyright = <"Cambio Healthcare Systems">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record patient information for esophagus and cardia cancer. Both clinical data and patient-evaluation reported data are registred throught this archetype.">
			use = <"Use for patients with esophagus cancer or cardia cancer.">
			keywords = <"VBH", "value based healthcare", "esophagus cancer", "cardiac cancer", "cancer">
			misuse = <"Do not use for other than to register patient data related to the cardia and esophagus cancer.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["references"] = <"1. LUL, Systemförvaltning (2009). \"Mall för journaltabell Esofaguscancer\". Landstninget Uppsala Län.">
		["MD5-CAM-1.0.1"] = <"6E8BAFD227045AB3EF59E463CDA7D7E1">
	>

definition
	EVALUATION[at0000] matches {	-- Esophagus cancer
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Review date (time)
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					CLUSTER[at0003] occurrences matches {0..1} matches {	-- Complications
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0004] occurrences matches {0..1} matches {	-- Oncology - Mucositis
								value matches {
									0|[local::at0005], 	-- Grade 0
									1|[local::at0006], 	-- Grade 1
									2|[local::at0007], 	-- Grade 2
									3|[local::at0008], 	-- Grade 3
									4|[local::at0009]  	-- Grade 4
								}
							}
							ELEMENT[at0010] occurrences matches {0..1} matches {	-- Oncology - Esophagitis
								value matches {
									0|[local::at0011], 	-- Grade 0
									1|[local::at0012], 	-- Grade 1
									2|[local::at0013], 	-- Grade 2
									3|[local::at0014], 	-- Grade 3
									4|[local::at0015]  	-- Grade 4
								}
							}
							ELEMENT[at0016] occurrences matches {0..1} matches {	-- Oncology - Neuropathy
								value matches {
									0|[local::at0017], 	-- Grade 0
									1|[local::at0018], 	-- Grade 1
									2|[local::at0019], 	-- Grade 2
									3|[local::at0020], 	-- Grade 3
									4|[local::at0021]  	-- Grade 4
								}
							}
							ELEMENT[at0022] occurrences matches {0..1} matches {	-- Surgery
								value matches {
									0|[local::at0023], 	-- Grade 0
									1|[local::at0024], 	-- Grade 1
									2|[local::at0025], 	-- Grade 2
									3|[local::at0026], 	-- Grade 3a
									4|[local::at0027], 	-- Grade 3b
									5|[local::at0028], 	-- Grade 4a
									6|[local::at0029], 	-- Grade 4b
									7|[local::at0030]  	-- Grade 5
								}
							}
						}
					}
					ELEMENT[at0031] occurrences matches {0..1} matches {	-- Planned treatment
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0032, 	-- Oncological and surgical
									at0033, 	-- Oncological
									at0034, 	-- Surgical
									at0035]	-- Palliative
								}
							}
						}
					}
					ELEMENT[at0036] occurrences matches {0..1} matches {	-- Care contact
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0037, 	-- Very good
									at0038, 	-- Quite good
									at0039, 	-- Quite bad
									at0040, 	-- Very bad
									at0041]	-- Not applicable
								}
							}
						}
					}
					ELEMENT[at0042] occurrences matches {0..1} matches {	-- Do you have a contact nurse?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0043, 	-- All the time
									at0044, 	-- Partly
									at0045, 	-- Never
									at0046]	-- Do not know
								}
							}
						}
					}
					ELEMENT[at0047] occurrences matches {0..1} matches {	-- Do you need some kind of support?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0048, 	-- Yes
									at0049, 	-- No
									at0050]	-- Does not have any need for support
								}
							}
						}
					}
					ELEMENT[at0051] occurrences matches {0..1} matches {	-- Have you understood the information you got?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0052, 	-- Always
									at0053, 	-- Often
									at0054, 	-- Sometimes
									at0055, 	-- Rarely
									at0056]	-- Never
								}
							}
						}
					}
					ELEMENT[at0057] occurrences matches {0..1} matches {	-- How has the information been?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0037, 	-- Very good
									at0038, 	-- Quite good
									at0039, 	-- Quite bad
									at0040, 	-- Very bad
									at0041]	-- Not applicable
								}
							}
						}
					}
					ELEMENT[at0058] occurrences matches {0..1} matches {	-- Eating problem
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0048, 	-- Yes
									at0049]	-- No
								}
							}
						}
					}
					ELEMENT[at0059] occurrences matches {0..1} matches {	-- Diet
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0060, 	-- Adjusted diet
									at0061]	-- Normal diet
								}
							}
						}
					}
					ELEMENT[at0062] occurrences matches {0..1} matches {	-- Weight before surgery
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::124]>
								list = <
									["1"] = <
										units = <"kg">
										magnitude = <|>=0.0|>
										precision = <|2|>
									>
									["2"] = <
										units = <"lb">
										magnitude = <|>=0.0|>
										precision = <|2|>
									>
								>
							>
						}
					}
					ELEMENT[at0063] occurrences matches {0..1} matches {	-- Weight loss
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::507]>
								list = <
									["1"] = <
										units = <"%">
										magnitude = <|>=0.0|>
										precision = <|2|>
									>
								>
							>
						}
					}
				}
			}
		}
	}

