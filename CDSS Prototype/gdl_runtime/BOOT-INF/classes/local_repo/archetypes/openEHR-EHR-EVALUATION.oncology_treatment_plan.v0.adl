archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.oncology_treatment_plan.v0

concept
	[at0000]	-- Oncology treatment plan
language
	original_language = <[ISO_639-1::en]>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["organisation"] = <"Cambio Healthcare Systems">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["date"] = <"2014-10-10">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record information about an individual's cancer treatment plan">
			use = <"">
			keywords = <"oncology", "cancer", "treatment plan">
			misuse = <"">
			copyright = <"">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <"Dr Johan Sandzen", ...>
	other_details = <
		["MD5-CAM-1.0.1"] = <"8DE9D47B5798A4B4069E721CE02E7E03">
	>

definition
	EVALUATION[at0000] matches {	-- Oncology treatment plan
		data matches {
			ITEM_TREE[at0001] matches {	-- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {	-- Treatment plan
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003, 	-- Curative
									at0004, 	-- Palliative
									at0027]	-- Absent
								}
							}
						}
					}
					CLUSTER[at0005] occurrences matches {0..1} matches {	-- Pre-operative stage
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0006] occurrences matches {0..1} matches {	-- Surgery
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
							ELEMENT[at0007] occurrences matches {0..1} matches {	-- Radiotherapy
								value matches {
									DV_BOOLEAN matches {
										value matches {True, False}
									}
								}
							}
							ELEMENT[at0008] occurrences matches {0..1} matches {	-- Pre-operative Anti-tumor medication
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0009, 	-- No
											at0010, 	-- Neoadjuvant
											at0011, 	-- Converting
											at0012, 	-- Palliative
											at0028]	-- Absent
										}
									}
								}
							}
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {	-- Awaiting operation
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0014, 	-- Neoadjuvant
									at0015, 	-- Converting
									at0016, 	-- Operation
									at0029]	-- Absent
								}
							}
						}
					}
					CLUSTER[at0017] occurrences matches {0..1} matches {	-- Post-operative stage
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0018] occurrences matches {0..1} matches {	-- Post-operative cohort
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0019, 	-- Post-operation
											at0020, 	-- Adjuvant
											at0021, 	-- Follow-up
											at0030]	-- Absent
										}
									}
								}
							}
							ELEMENT[at0022] occurrences matches {0..1} matches {	-- Post-operative Anti-tumor medication
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0023, 	-- Adjuvant
											at0024, 	-- Palliative
											at0025, 	-- No
											at0031]	-- Absent
										}
									}
								}
							}
						}
					}
					ELEMENT[at0026] occurrences matches {0..1} matches {	-- Review date (time) of treatment plan
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
				}
			}
		}
	}

