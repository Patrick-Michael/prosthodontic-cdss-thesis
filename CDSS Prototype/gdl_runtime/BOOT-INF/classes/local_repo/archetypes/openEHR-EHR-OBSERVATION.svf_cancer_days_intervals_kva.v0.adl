			purpose = <"Attribute days intervals for Dashboard categories for SVF kva cancer case study.">
			use = <"Use to register patient data into Dashboard categories for the SVF kva cancer case study.">
			keywords = <"SVF", "cancer", "days">
			misuse = <"Do not use to register data for a process other than  the SVF kva cancer case study.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
