archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.ischemic_heart_disease_case_study.v1

concept
	[at0000]	-- Ischemic heart disease study
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"Konstantinos Kalliamvakos">
		["email"] = <"Konstantinos.Kalliamvakos@cambio.se">
		["organisation"] = <"Cambio Healthcare Systems">
		["date"] = <"2014-07-25">
	>
	details = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"För att registrera resultatet vid körning av studien ischemisk hjärtsjukdoms riktlinjer.">
			use = <"Använd bara i förhållande till studien ischemisk hjärtsjukdom. Den information som produceras av riktlinjerna är resultatet av särskilda studiekriterier.">
			keywords = <"öppna jämförelser", "vårtid", "sjukhusvård", "ischemisk hjärtsjukdom", "dödlighet", "överlevnad", "statiner", "antikoagulantia", "Socialstyrelsen">
			misuse = <"Använd inte i andra studier eller sammanhang utom när kriterierna är identiska med dem som definieras i studien ischemisk hjärtsjukdom.">
			copyright = <"Cambio Healthcare Systems">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the result from the execution of the ischemic heart disease study guidelines.">
			use = <"Use only in relation to the ischemic heart disease study. The information produced by the guidelines is the result of specific study criteria.">
			keywords = <"healthcare indicators", "length of stay", "hospitalization", "ischemic heart disease", "mortality", "survival", "statins", "anticoagulants", "Socialstyrelsen">
			misuse = <"Do not use in other studies or context except in the case that the criteria are identical with those defined in the ischemic heart disease study.">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <>
	other_details = <
		["current_contact"] = <"Konstantinos Kalliamvakos, Cambio Healthcare Systems, Konstantinos.Kalliamvakos@cambio.se">
		["MD5-CAM-1.0.1"] = <"F05834F5C836BF334A923B119D60CFA9">
	>

definition
	OBSERVATION[at0000] matches {	-- Ischemic heart disease study
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- Anticoagulants in ischemic heart disease
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- Absent
													at0006]	-- Present
												}
											}
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {	-- Statins in ischemic heart disease
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- Absent
													at0006]	-- Present
												}
											}
										}
									}
									ELEMENT[at0008] occurrences matches {0..1} matches {	-- Ischemic heart disease patients that got hospitalized within the last 12 months
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005, 	-- Absent
													at0006]	-- Present
												}
											}
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {	-- Number of hospitalized days for patients with ischemic heart disease
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0010, 	-- < 3 days
													at0011, 	-- 3-5 days
													at0012, 	-- 6-10 days
													at0013, 	-- 11-20 days
													at0014, 	-- 21-30 days
													at0015]	-- > 30 days
												}
											}
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {	-- Length of stay
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::128]>
												list = <
													["1"] = <
														units = <"d">
													>
													["2"] = <
														units = <"millisec">
													>
												>
											>
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {	-- Ischemic heart disease mortality
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0018, 	-- Died within 28 days
													at0019, 	-- Died within 29-90 days
													at0020, 	-- Died after 90 days
													at0021]	-- Alive
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

