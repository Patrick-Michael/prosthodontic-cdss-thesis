archetype (adl_version=1.4)
	openEHR-EHR-OBSERVATION.deep_vein_thrombosis_diagnos.v0

concept
	[at0000]	-- Deep vein thrombosis diagnosis
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			author = <
				["name"] = <"?">
			>
		>
	>
description
	original_author = <
		["name"] = <"">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Riskfactors for in Deep Vein Thrombosis (DVT) and points based diagnosis aid. ">
			use = <"Used as a diagnosis aid upon suspected  Deep Vein Thrombosis (DVT). ">
			keywords = <"DVT", " Deep Vein Thrombosis", "diagnosis", "risk factors", "thrombus", "embolism">
			misuse = <"Attention should be taken to the fact that this diagnosis aid is not evaluated for patients with the Pill, estrogen treatment, pregnancy and 8 weeks postpartum. Do not use for other then to calculate and assess the risk for DVT. ">
			copyright = <"Cambio Healthcare Systems">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"Riskfaktorer för djupventrombos (DVT) och poängbaserat diagnostikstöd.">
			use = <"Används som diagnostikstöd vid misstänkt djupventrombos. ">
			keywords = <"DVT", "djup ventrombos", "diagnostik", "riskfaktorer", "blodpropp">
			misuse = <"Hänsyn bör tas till att diagnostikstöd ej är utvärderat för patienter med P-Piller, behandling med östrogen, graviditet och postpartum 8 veckor. Används inte för annat än föra tt räkna risken för DVT. ">
			copyright = <"Cambio Healthcare Systems">
		>
	>
	lifecycle_state = <"0">
	other_contributors = <>
	other_details = <
		["references"] = <"Eriksson H., et al. Djup Ventrombos. From www.internetmedicin.se, November 2015. 
Socialstyrelsen. Socialstyrelsens riktlinjer för vård av blodpropp/venös tromboembolism 2004. Stockholm 2004. 
Wells PS, Hirsh J, Anderson DR, et al. Accuracy of clinical assessment of deep-vein thrombosis. Lancet 1995;345:1326-30">
		["MD5-CAM-1.0.1"] = <"78F697D9E24CBB6FF239C4E277D1D774">
	>

definition
	OBSERVATION[at0000] matches {	-- Deep vein thrombosis diagnosis
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {	-- Any event
						data matches {
							ITEM_TREE[at0003] matches {	-- *Tree(en)
								items cardinality matches {0..*; ordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {	-- *New element(en)
										value matches {
											DV_DATE_TIME matches {
												value matches {yyyy-mm-ddTHH:??:??}
											}
										}
									}
									CLUSTER[at0005] occurrences matches {0..1} matches {	-- Strong risk factors for DVT
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0006] occurrences matches {0..1} matches {	-- Active malignity
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0059, 	-- Present
															at0060]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0007] occurrences matches {0..1} matches {	-- Previous thrombosis
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0062, 	-- Present
															at0063]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0008] occurrences matches {0..1} matches {	-- Immobilization- paresis or plaster  
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0064, 	-- Present
															at0065]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0058] occurrences matches {0..1} matches {	-- Operation/trauma 
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0066, 	-- Present
															at0067]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0009] occurrences matches {0..1} matches {	-- Infection 
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0068, 	-- Present
															at0069]	-- Absent
														}
													}
												}
											}
										}
									}
									CLUSTER[at0010] occurrences matches {0..1} matches {	-- Riskfactors for DVT
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0011] occurrences matches {0..1} matches {	-- Immobilization- small calf muscle activity
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0070, 	-- Present
															at0071]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0012] occurrences matches {0..1} matches {	-- Overweight
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0072, 	-- Present
															at0073]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0013] occurrences matches {0..1} matches {	-- Estrogen/ Pill/8 weeks postpartum
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0074, 	-- Present
															at0075]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0014] occurrences matches {0..1} matches {	-- Family history for vein thrombosis
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0076, 	-- Present
															at0077]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0015] occurrences matches {0..1} matches {	-- Coagulopaty
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0078, 	-- Present
															at0079]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0016] occurrences matches {0..1} matches {	-- inflammatory bowel disease
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0080, 	-- Present
															at0081]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0017] occurrences matches {0..1} matches {	-- Serum albumin < 25g/l
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0082, 	-- Present
															at0083]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0018] occurrences matches {0..1} matches {	-- I.v. Catheters and Cables
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0084, 	-- Present
															at0085]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0019] occurrences matches {0..1} matches {	-- Advanced age
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0086, 	-- Present
															at0087]	-- Absent
														}
													}
												}
											}
											ELEMENT[at0020] occurrences matches {0..1} matches {	-- Smoking
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0088, 	-- Present 
															at0089]	-- Absent
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

