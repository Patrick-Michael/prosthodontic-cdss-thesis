				>
				["at0107"] = <
					text = <"Registered">
					description = <"No result yet available.">
				>
				["at0108"] = <
					comment = <"Allows a single test result to contain multiple individual results each with their own status.">
					text = <"Result Value Status">
					description = <"The status of the result value.">
				>
				["at0110"] = <
					text = <"Test Procedure">
					description = <"Additional structured details of pathology test methodology followed. For example, structured details about the laboratory method and data interpretation used.">
				>
			>
		>
		["sv"] = <
			items = <
				["at0.111"] = <
					text = <"\"Point of Care\" instrument som använts.">
					description = <"Testet utfördes med hjälp av ett instrument vid \"point of care\" eller ett hembaserat instrument.">
				>
				["at0.112"] = <
					text = <"*Tree(en)">
					description = <"*@ internal @(en)">
				>
				["at0.113"] = <
					text = <"Fastande tillstånd">
					description = <"Ett fasteprov användes för mätningen.">
				>
				["at0.114"] = <
					text = <"Varaktighet för Fasta">
					description = <"Duration av fasta slutförd av testpersonen innan provet tagits.">
				>
				["at0000"] = <
					comment = <"*This archetype may be used to record a single valued test, but will often be specialised or templated to represent multiple value or 'panel' tests. This archetype also acts as the parent for specialisations appropriate for more specific laboratory tests, e.g. microbiology, histopathology.(en)">
					text = <"Patologi Testresultat">
					description = <"Resultat och tolkning av patologitester på patientrelaterade prov.">
				>
				["at0000.1"] = <
					text = <"Lipid Studiens Testresultat">
					description = <"Resultat och tolkning av bochemical lipid studiens testresultat.">
				>
				["at0001"] = <
					text = <"*Event Series(en)">
					description = <"*@ internal @(en)">
				>
				["at0002"] = <
					text = <"*Any event(en)">
					description = <"*Any event.(en)">
				>
				["at0003"] = <
					text = <"*Tree(en)">
					description = <"*@ internal @(en)">
				>
				["at0004"] = <
					text = <"*Tree(en)">
					description = <"*@ internal @(en)">
				>
				["at0005"] = <
					comment = <"*A test result may be for a single analyte, or a group of items, including panel tests. Coding with a terminology, potientially a pre-coordinated term including specimen type, is preferred, where possible. May be coded with LOINC or Snomed-CT. Examples include \"Glucose\", \"Urea and Electrolytes\", \"Swab\",  “Cortisol (am)” or \"Liver Biopsy\".(en)">
					text = <"Testresultat Namn">
					description = <"Identifiering av utfört patologitest, ibland inklusive provtyp och patienttillstånd.">
				>
				["at0010"] = <
					comment = <"*Multiple formats are allowed but they must be semantically equivalent.(en)">
					text = <"Testresultat Representation">
					description = <"Omfattande text representation av hela resultatet som utfärdats av den diagnostiska tjänsten.">
				>
				["at0017"] = <
					text = <"Mottagande Laboratorium">
					description = <"Demografiska uppgifter om det laboratorium som har ansvar för patologitestet.">
				>
				["at0035"] = <
					text = <"Kopia adressat">
					description = <"Uppgifter om klinikern eller organisationen som kommer att få en kopia av patologi testresultatet.">
				>
				["at0037"] = <
					text = <"Tillfällig">
					description = <"Detta är ett första eller ett delresultat: data kan saknas eller verifiering har inte utförts.">
				>
				["at0038"] = <
					text = <"Slutligt">
					description = <"Resultatet är komplett och verifierat av den ansvariga patologen.">
				>
				["at0040"] = <
					text = <"Ändrad">
					description = <"Resultatet har ändrats efter att vara Slutligt, och är slutförd och verifierat av den ansvarige patologen.">
				>
				["at0057"] = <
					text = <"Slutsats">
					description = <"Kortfattad och kliniskt kontextualiserad berättande tolkning av patologi testresultaten.">
				>
				["at0062"] = <
					comment = <"*Equivalent to the Placer Order Identifier.(en)">
					text = <"Beställare Order Identifierare">
					description = <"Lokalt ID som tilldelats till ordern av beställaren av ordern.">
				>
				["at0063"] = <
					comment = <"*Assigning an identifier to a request by the Radiology lnformation System enables tracking progress of the request and enables linking results to requests. It also provides a reference to assist with enquiries and it is usually equivalent to the HL7 Filler Order Identifier.(en)">
					text = <"Mottagare Order Identifierare">
					description = <"Lokalt ID som tilldelats testet av beställaren av ordern, vanligen genom Laboratory Information System (LIS).">
				>
				["at0065"] = <
					text = <"Prov Detalj">
					description = <"Detaljer om provet om alla enskilda testresultat härrör från samma prov. Om provtypen är tillräckligt specificerad med en kod i Testresultat namn, så krävs denna  ytterligare uppgifter inte. Om det finns flera provexemplar, kan dessa representeras/presenteras per \"Result-grupp\".">
				>
				["at0068"] = <
					text = <"Laboratorie Testresultat Identifierare">
					description = <"Identifieraren som givits till laboratorie testresultatet vid en patologi utredning.">
				>
				["at0073"] = <
					text = <"Övergripande testresultat status">
					description = <"Publikationsstatus för hela patologi testresultatet.">
				>
				["at0074"] = <
					text = <"Inställd/Avbruten">
					description = <"Resultatet är inte tillgängligt eftersom testet inte startades eller inte slutfördes.">
				>
				["at0075"] = <
					text = <"Datum tid resultatet utfärdats">
					description = <"Datum och/eller tid som hela resultatet utfärdades för det registrerade \"Övergripande testresultat status\".">
				>
				["at0077"] = <
					comment = <"*For example, biochemistry, haematology. Coding with a terminology is desirable, where possible.(en)">
					text = <"Diagnostisk Tjänst">
					description = <"Diagnostjänst som utför undersökningen.">
				>
				["at0078"] = <
					comment = <"*Most result values will be numerical measurements, but others may be coded concepts, free text, or multimedia images.(en)">
					text = <"Resultatvärde">
					description = <"Verkligt värde av resultatet.">
				>
				["at0078.1"] = <
					text = <"Total Kolesterol Resultatvärde">
					description = <"Verkligt värde av resultatet.">
				>
				["at0078.2"] = <
					text = <"Resultatvärde">
					description = <"Verkligt värde av resultatet.">
				>
				["at0078.3"] = <
					text = <"HDL Resultatvärde">
					description = <"Verkligt värde av resultatet.">
				>
				["at0078.4"] = <
					text = <"Resultatvärde">
					description = <"Verkligt värde av resultatet.">
				>
				["at0078.5"] = <
					text = <"Resultatvärde">
					description = <"Verkligt värde av resultatet.">
				>
				["at0078.6"] = <
					text = <"Resultatvärde">
					description = <"Verkligt värde av resultatet.">
				>
				["at0078.7"] = <
					text = <"LDL Resultatvärde">
					description = <"Verkligt värde av resultatet.">
				>
				["at0078.8"] = <
					text = <"Resultatvärde">
					description = <"Verkligt värde av resultatet.">
				>
				["at0090"] = <
					text = <"Beställare">
					description = <"Uppgifter om klinikern eller organisationen som beställer patologi testresultatet.">
				>
				["at0094"] = <
					comment = <"*Usually there is one test request (or \"order\") for each result, however in some circumstances multiple test requests may be represented using a single Pathology test result archetype.(en)">
					text = <"Detaljerad testordination">
					description = <"Detaljer avseende ett enda begärt patologiprov.">
				>
				["at0095"] = <
					comment = <"* If a name or code is used, it is provided by run-time re-naming of the Results may be grouped by specimen, or by some other name or code to describe what binds all the results together. 'Result group' element or may be fixed in a specialised archetype or template. Coding with a terminology, potentially a pre-coordinated term including specimen type, is preferred where possible for the name. Should be coded with LOINC or SNOMED CT.(en)">
					text = <"Resultat Grupp">
					description = <"En grupp av resultat.">
				>
				["at0096"] = <
					comment = <"*Results include whatever specific data items pathology labs report as part of the clinical service; it is not confined to measurements. The result is identified by run-time re-naming of the 'Result group' element or may be fixed in a specialised archetype or template. Coding with a terminology, potentially a pre-coordinated term including specimen type, is preferred where possible for the name. Should be coded with LOINC or SNOMED CT. Examples include: glucose, haemoglobin, phenotype, titre, or scatterplot image. If the test result is for a single analyte, then both the \"Test Result Name\" and the \"Result\" item will specify the same test.(en)">
					text = <"Resultat">
					description = <"Specifikt detaljeradt resultat, inklusive både värdet av resultatet för objektet och ytterligare information som kan vara till nytta för klinisk tolkning.">
				>
				["at0096.1"] = <
					text = <"Totalt/HDL-kolesterol förhållande">
					description = <"Specifikt detaljerat resultat, inklusive både värdet av resultatet för objektet och ytterligare information som kan vara till nytta för klinisk tolkning.">
				>
				["at0096.2"] = <
					text = <"LDL/HDL-kolesterol">
					description = <"Specifikt detaljerat resultat, inklusive både värdet av resultatet för objektet och ytterligare information som kan vara till nytta för klinisk tolkning.">
				>
				["at0096.3"] = <
					text = <"VLDL kolesterol">
					description = <"Specifikt detaljerat resultat, inklusive både värdet av resultatet för objektet och ytterligare information som kan vara till nytta för klinisk tolkning.">
				>
				["at0096.4"] = <
					text = <"LDL kolesterol Direkt analys">
					description = <"Specifikt detaljerat resultat, inklusive både värdet av resultatet för objektet och ytterligare information som kan vara till nytta för klinisk tolkning.">
				>
				["at0096.5"] = <
					text = <"HDL-kolesterol">
					description = <"Specifikt detaljerat resultat, inklusive både värdet av resultatet för objektet och ytterligare information som kan vara till nytta för klinisk tolkning.">
				>
				["at0096.6"] = <
					text = <"Total kolesterol">
					description = <"Specifik detaljerade resultat, inklusive både värdet av resultatet objektet och ytterligare information som kan vara till nytta för klinisk tolkning.">
				>
				["at0096.7"] = <
					text = <"Triglycerid">
					description = <"Specifikt detaljerat resultat, inklusive både värdet av resultatet för objektet och ytterligare information som kan vara till nytta för klinisk tolkning.">
				>
				["at0096.8"] = <
					text = <"LDL-kolesterol Beräknat">
					description = <"Specifikt detaljerat resultat, inklusive både värdet av resultatet för objektet och ytterligare information som kan vara till nytta för klinisk tolkning.">
				>
				["at0097"] = <
					text = <"Prov Detalj">
					description = <"Detaljer om enskilda prov till vilka \"Resultat grupp\" testresultat refererar, där testning av flera prover krävs.">
				>
				["at0098"] = <
					comment = <"*Coding with a terminology is preferred, where possible.(en)">
					text = <"Patologisk diagnos">
					description = <"Enskilt ord, en fras eller en kort beskrivning som representerar berättelsen i \"Slutsatsen\".">
				>
				["at0100"] = <
					text = <"Klinisk information som lämnats">
					description = <"Beskrivning av klinisk information som finns tillgänglig vid tidpunkten för tolkningen av resultaten, vilket kan inkludera en länk till den ursprungliga kliniska uppgif som erhålls i test ordinationen.">
				>
				["at0101"] = <
					text = <"Test Kommentar">
					description = <"Ytterligare information om testet som inte fångats i andra områden.">
				>
				["at0102"] = <
					comment = <"*May include statements about significant, unexpected or unreliable. values, or information about the source of the value where this may be relevant to the interpretation of the result.(en)">
					text = <"Resultat Kommentar">
					description = <"Kommentar om resultatet.">
				>
				["at0103"] = <
					text = <"Referensvärde Vägledning">
					description = <"Övrig information om tillämpligheten av referenvärdet.">
				>
				["at0106"] = <
					text = <"Testordination Namn">
					description = <"Identifiering av begärt patologitest, där begärt test skiljer sig från det test som faktiskt genomförts.">
				>
				["at0107"] = <
					text = <"Registrerad">
					description = <"Resultat ännu inte tillgängligt.">
				>
				["at0108"] = <
					comment = <"*Allows a single test result to contain multiple individual results each with their own status.(en)">
					text = <"Resultat Värde Status">
					description = <"Status för resultatvärde.">
				>
				["at0110"] = <
					text = <"Testförfarande">
					description = <"Ytterligare strukturerade uppgifter om patologi testmetodologi. Till exempel strukturerad information om laboratoriemetoden och datatolkningen som använts.">
				>
			>
		>
	>
